---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const SITE_URL = 'https://www.mychatbot.ro';
const ORG_ID = `${SITE_URL}/#organization`;
const PAGE_URL = `${SITE_URL}/industrii/atractii-turistice`;
const COVER_URL = `${SITE_URL}/industrii/atractii-turistice-cover.svg`;

const faqs = [
  {
    q: "Funcționează pentru atracții cu volum mare de vizitatori?",
    a: "Da. Pentru atracțiile cu volum mare (muzee naționale, castele de patrimoniu, parcuri tematice cu mii de vizitatori în weekend), planul Pro oferă conversații nelimitate și gestionează simultan zeci de cereri în limbi diferite. Concierge-ul AI elimină vârfurile de telefon din zilele aglomerate — personalul se concentrează pe vizitatorii prezenți, nu pe răspunsuri telefonice."
  },
  {
    q: "Înțelege programele sezoniere și modificările de orar?",
    a: "Da. Concierge-ul AI răspunde cu programul real configurat: orar normal, program sezonier (deschis mai-octombrie, închis iarna), zilele libere săptămânale (multe muzee sunt închise lunea), evenimente speciale care modifică orarul. Crawl-ul zilnic (planul Pro) actualizează automat modificările temporare fără intervenție tehnică — ceea ce e critic pentru atracțiile cu programe variabile."
  },
  {
    q: "Gestionează tarife multiple (adulți, copii, studenți, pensionari)?",
    a: "Da. Concierge-ul AI cunoaște logica tarifelor multiple categorii: adulți, copii (cu intervale de vârstă specifice), studenți (cu legitimație), pensionari, persoane cu dizabilități, militari, grupuri organizate (cu număr minim de persoane), abonamente de familie. Pentru cazuri specifice (verificarea unei legitimații, situații rare), redirecționează spre personalul de la casa de bilete."
  },
  {
    q: "Răspunde în limbi străine pentru turiștii internaționali?",
    a: "Da. Concierge-ul AI răspunde nativ în 50+ limbi, detectând automat limba mesajului. Pentru destinațiile cu trafic internațional consistent, capacitatea de a răspunde în engleză, germană, italiană, franceză, spaniolă, japoneză, ucraineană e standard. Răspunsurile sunt idiomatice — nu traduceri rigide care diminuează experiența premium."
  },
  {
    q: "Poate gestiona rezervări pentru tururi ghidate?",
    a: "Da. Pentru atracțiile care oferă tururi ghidate (private sau pe grupuri), concierge-ul AI colectează cererea (data, ora, număr persoane, limbă preferată ghid, cerințe speciale) și o trimite spre confirmare. Pentru ghizi locali independenți, concierge-ul gestionează direct calendarul și verifică disponibilitatea pentru perioade specifice."
  },
  {
    q: "Sunt datele vizitatorilor protejate conform GDPR?",
    a: "Da. MyChatbot procesează datele exclusiv pe servere UE (Frankfurt) și nu păstrează conținutul conversațiilor mai mult decât e necesar pentru funcționare. Acordul de procesare a datelor (DPA) este disponibil în limba română și conform Regulamentului UE 2016/679. Vizitatorul primește acord explicit înainte ca conversația să fie procesată."
  },
  {
    q: "Se integrează cu sistemele de ticketing online?",
    a: "Pentru atracțiile cu sistem propriu de ticketing online (sau parteneri ca Eventim, BiletMaster), concierge-ul AI poate verifica disponibilitatea bilete pentru date specifice prin integrare iCal (planul Standard în sus) sau redirecționează direct spre platforma de ticketing pentru achiziție. Pentru atracțiile fără sistem online, concierge-ul colectează cererile și le trimite personalului pentru rezervare manuală."
  },
  {
    q: "Cum se instalează pe site?",
    a: "Instalarea durează sub 5 minute — un fragment de cod JavaScript (un singur rând) adăugat în secțiunea HTML a site-ului. Funcționează pe orice CMS: WordPress, Wix, Shopify, Squarespace, Webflow, Astro, sau site-uri custom HTML. Echipa Hello Web te asistă gratuit la setup dacă ai nevoie de ajutor — fără cost suplimentar."
  }
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Concierge AI pentru atracții și destinații turistice",
  "description": "Concierge AI specializat pentru ghizi locali, atracții, parcuri tematice și muzee. Răspunde 24/7 la întrebări despre program, tarife, accesibilitate și rezervări — în 50+ limbi.",
  "url": PAGE_URL,
  "image": COVER_URL,
  "provider": { "@id": ORG_ID },
  "areaServed": { "@type": "Country", "name": "Romania" },
  "serviceType": "AI Customer Service for Tourist Attractions",
  "category": "Tourism Technology",
  "audience": {
    "@type": "BusinessAudience",
    "audienceType": "Tourist Attractions, Museums, Theme Parks, Local Guides"
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Acasă", "item": SITE_URL },
    { "@type": "ListItem", "position": 2, "name": "Industrii", "item": `${SITE_URL}/industrii` },
    { "@type": "ListItem", "position": 3, "name": "Atracții turistice", "item": PAGE_URL }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": { "@type": "Answer", "text": item.a }
  }))
};
---

<Layout
  title="Concierge AI pentru atracții și destinații turistice — MyChatbot"
  description="Concierge AI specializat pentru ghizi locali, atracții, parcuri tematice și muzee. Răspunde 24/7 la programe, tarife, accesibilitate și rezervări."
  canonical={PAGE_URL}
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <Nav basePath="/" />

  <main>
    <nav class="breadcrumb-nav" aria-label="breadcrumb">
      <div class="container">
        <a href="/">Acasă</a>
        <span class="separator">›</span>
        <a href="/industrii/">Industrii</a>
        <span class="separator">›</span>
        <span class="current">Atracții turistice</span>
      </div>
    </nav>

    <section class="vert-hero">
      <div class="container">
        <span class="section-tag">VERTICALA · ATRACȚII TURISTICE</span>
        <h1>Concierge AI pentru atracții și destinații turistice</h1>
        <p class="lead">De la ghizi locali cu tururi mici la muzee naționale și parcuri tematice cu mii de vizitatori zilnic, un concierge AI răspunde 24/7 la întrebări despre program, tarife, accesibilitate și rezervări — în limba turistului, fără să blocheze biroul de informații. Pentru atracțiile turistice din România, e diferența între a oferi o experiență premium începând cu primul mesaj și a pierde turistul care alege altă destinație pentru că nu a primit răspuns rapid.</p>
        <p>În 2026, peste 80% dintre vizitele la atracții turistice încep cu o căutare online — programe, prețuri, ce să vezi, cum ajungi. Atracțiile care răspund rapid și clar cu informații actualizate câștigă încrederea turiștilor. Cele care lasă întrebările în așteptare ratează nu doar vizita, ci și recomandarea către prieteni.</p>
        <div class="hero-img-wrapper">
          <img src="/industrii/atractii-turistice-cover.svg" alt="Concierge AI pentru atracții și destinații turistice" width="1200" height="630" />
        </div>
      </div>
    </section>

    <section class="vert-section">
      <div class="container">
        <h2>Pentru cine este concierge-ul AI MyChatbot</h2>
        <p>MyChatbot acoperă tot range-ul atracțiilor turistice — de la ghizi locali independenți care oferă tururi private prin orașe vechi, la castele și parcuri tematice cu sute de vizitatori zilnici, până la muzee naționale cu trafic internațional masiv. Logica de bază e aceeași: răspunsuri instant la program, tarife, accesibilitate și rezervări. Diferența între planuri stă în volumul de conversații, complexitatea sistemelor de bilete și capacitatea multilingvă.</p>

        <div class="subverticals-grid">
          <article class="subvert-card">
            <div class="plan-badge plan-start">PLAN START · 150 lei/lună</div>
            <h3>Ghizi și atracții locale mici</h3>
            <p>Pentru ghizi independenți și atracții locale mici (case memoriale, mănăstiri restaurate, situri arheologice locale, biserici fortificate), concierge-ul AI Start răspunde automat la întrebările repetitive: program, tarife, durata vizitei, ce trebuie văzut, cum se ajunge la locație. Setup-ul durează sub o oră și include trial gratuit 7 zile pe planul Standard.</p>
            <p>Pentru un ghid local din Brașov sau Sibiu care oferă tururi prin Centrul Vechi, concierge-ul AI gestionează cererile de rezervare pentru tururi private, oferă informații despre prețuri pe persoană, durata, ce include (degustări, intrări la atracții), preia datele turistului și trimite cererea spre confirmare. Un ghid recuperează 1-2 ore zilnic de timp altfel consumat pe răspunsuri identice.</p>
          </article>

          <article class="subvert-card">
            <div class="plan-badge plan-standard">PLAN STANDARD · 250 lei/lună</div>
            <h3>Atracții, parcuri și complexuri turistice</h3>
            <p>Pentru atracții cu volum mediu-mare (Castelul Bran, Salina Turda, Therme București, Aqua Park-uri, parcuri tematice, complexe turistice montane), concierge-ul AI Standard gestionează multiple categorii de tarife (adulți, copii, studenți, pensionari, grupuri), informează despre programul sezonier, integrează cu sistemele de ticketing pentru rezervări online și răspunde în multiple limbi pentru turiștii internaționali.</p>
            <p>Pentru un castel istoric cu 2000+ vizitatori în weekend, concierge-ul AI elimină vârfurile de telefon din zilele de vineri-sâmbătă. Întrebările despre durata vizitei, audio-ghizi, restaurant pe locație, parcare, accesibilitate cu cărucior — toate primesc răspuns instant 24/7, în limba turistului. Personalul de la biroul de informații se concentrează pe vizitatori prezenți, nu pe telefoane.</p>
          </article>

          <article class="subvert-card">
            <div class="plan-badge plan-pro">PLAN PRO · 550 lei/lună</div>
            <h3>Muzee și destinații turistice naționale</h3>
            <p>Pentru muzee naționale (MNAR, Muzeul Antipa, Muzeul Țăranului Român, Muzeul Național de Istorie), castele de patrimoniu (Peleș, Bran, Corvinilor) și destinații cu trafic internațional masiv, concierge-ul AI Pro gestionează zeci de cereri simultan, în zeci de limbi diferite, integrează cu sistemele complexe de ticketing și produce rapoarte detaliate.</p>
            <p>Pentru un muzeu cu peste 500.000 vizitatori anual și trafic internațional consistent, capacitatea de a răspunde nativ în engleză, germană, italiană, franceză, spaniolă, japoneză e critică. Conversațiile nelimitate, crawl-ul zilnic al modificărilor (expoziții temporare, evenimente speciale, închideri pentru renovare) și rapoartele detaliate sunt funcționalități esențiale.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="vert-section">
      <div class="container">
        <h2>Cum ajută concierge AI o atracție sau destinație turistică</h2>
        <p>Patru probleme tipice și soluțiile concrete oferite de un concierge AI specializat.</p>

        <div class="problem-block">
          <h3>Programul sezonier și modificările de orar</h3>
          <p>Multe atracții au programe diferite pe sezon — castele deschise mai-octombrie, muzee cu zile libere lunea, parcuri tematice închise iarna, mănăstiri cu programul de vizitare diferit de cel liturgic. Pentru turiștii care planifică vizita cu zile sau săptămâni înainte, informațiile actualizate sunt critice — nimic nu deteriorează mai mult experiența decât a ajunge într-o duminică la un castel pentru a descoperi că e închis luni.</p>
          <p>Cu concierge AI, turistul primește instant programul real configurat (orar normal, programe sezoniere, închideri pentru sărbători legale, evenimente speciale care modifică orarul). Pentru planul Pro, crawl-ul zilnic actualizează automat orice modificare temporară fără intervenție tehnică — ceea ce înseamnă că informațiile rămân corecte chiar și când există schimbări last-minute.</p>
        </div>

        <div class="problem-block">
          <h3>Tarifele multiple pentru categorii diferite</h3>
          <p>"Cât costă pentru adulți?", "Există tarif redus pentru copii?", "De la ce vârstă plătesc copiii?", "Studenții au reducere?", "Pensionarii?", "Există abonamente de familie?", "Pentru grupuri organizate care e tariful?", "Audio-ghidul e inclus sau separat?". Aceste întrebări identice consumă timp prețios al personalului de la casa de bilete — exact când oamenii așteaptă la coadă să cumpere bilete.</p>
          <p>Concierge-ul AI răspunde instant pe baza listei reale de tarife configurate. Pentru cazuri specifice (verificarea unei legitimații de student, situații medicale care dau gratuitate), redirecționează spre personalul de la fața locului. Dar 80% din întrebările despre tarife sunt rezolvate automat înainte ca turistul să ajungă la fața locului.</p>
        </div>

        <div class="problem-block">
          <h3>Bariera lingvistică pentru turiști internaționali</h3>
          <p>Pentru destinațiile turistice cu trafic internațional consistent (Bran, Peleș, Sighișoara, Brașov, Sibiu, Sibiu Sud, Maramureș), traficul în engleză, germană, italiană, franceză, ucraineană e o constantă. Un site bilingv parțial sau personal care nu vorbește toate limbile creează o experiență fragmentată — turistul care nu înțelege programul exact riscă să rateze vizita.</p>
          <p>Concierge-ul AI detectează automat limba mesajului și răspunde nativ în 50+ limbi cu informații reale despre programe, tarife, durata vizitei, ce să vezi. Pentru un turist american care planifică vizita la Castelul Corvinilor sau un japonez care vrea informații despre Mănăstirea Voroneț, răspunsul vine instant în limba lor — natural, idiomatic.</p>
        </div>

        <div class="problem-block">
          <h3>Accesibilitate și restricții speciale</h3>
          <p>"Există acces cu căruciorul pentru bebeluș?", "Scaun rotile?", "Acceptați animale de companie?", "Există toalete pentru persoane cu dizabilități?", "Drumul până la castel e dificil?", "Câte trepte sunt?", "Există bară de acces?", "Pentru copii foarte mici e potrivit?". Aceste întrebări legitime sunt critice pentru planificarea vizitei — și răspunsul vag sau lipsa răspunsului poate descuraja vizita complet.</p>
          <p>Concierge-ul AI răspunde instant cu informații specifice configurate despre accesibilitate, infrastructura, restricții. Pentru cazuri complexe care necesită evaluare specifică (echipament medical, situații rare), transferă conversația către personalul de la fața locului — dar majoritatea întrebărilor primesc răspuns clar și onest înainte de vizită.</p>
        </div>
      </div>
    </section>

    <section class="vert-section vert-section-alt">
      <div class="container">
        <h2>Concierge AI specializat vs. chatbot generic — comparație pentru atracții turistice</h2>
        <p>Diferența nu e doar de preț, ci de înțelegere a contextului turistic și cultural. Un chatbot generic nu cunoaște diferența între "tichet de intrare" și "audio-ghid", nu poate gestiona logica tarifelor multiple categorii, nu înțelege specificul programului sezonier al atracțiilor istorice. Un concierge AI specializat MyChatbot pleacă cu acest context preinstalat.</p>

        <div class="comparison-table-wrapper">
          <table class="comparison-table">
            <thead>
              <tr><th>Criteriu</th><th>Chatbot generic</th><th>MyChatbot pentru atracții</th></tr>
            </thead>
            <tbody>
              <tr><td>Cunoaștere domeniu turism</td><td>Generală, learn from scratch</td><td>Pre-antrenat pe scenarii atracții</td></tr>
              <tr><td>Limba română</td><td>Variabilă, traducere</td><td>Nativă, idiomatică</td></tr>
              <tr><td>Înțelegere tarife multiple</td><td>Slabă</td><td>Cunoaște adulți/copii/studenți/pensionari/grupuri</td></tr>
              <tr><td>Programe sezoniere</td><td>Generic</td><td>Cunoaște patternuri castele/muzee/parcuri</td></tr>
              <tr><td>Suport în română</td><td>Rar</td><td>Standard, în 5 minute</td></tr>
              <tr><td>Conformitate GDPR-RO</td><td>Generică</td><td>Server UE, DPA în română</td></tr>
              <tr><td>Multilingvistic pentru turiști</td><td>Limitat</td><td>50+ limbi, detectare automată</td></tr>
              <tr><td>Tonalitate adaptată</td><td>Generic</td><td>Educat pentru muzee, friendly pentru parcuri</td></tr>
              <tr><td>Setup pentru atracție mică</td><td>Configurare extinsă</td><td>Sub o oră, fără cunoștințe tehnice</td></tr>
              <tr><td>Preț pentru atracție mică</td><td>100-500 EUR/lună</td><td>30 EUR/lună (150 lei)</td></tr>
            </tbody>
          </table>
        </div>

        <p>Pentru un manager de atracție fără echipă tehnică, diferența practică se vede în primele 30 de minute. Un chatbot generic îi cere să configureze de la zero ce înseamnă "tarif pentru grup organizat de minim 15 persoane". MyChatbot știe deja aceste concepte și se concentrează pe particularitățile atracției tale.</p>
      </div>
    </section>

    <section class="vert-section">
      <div class="container">
        <h2>ROI: cât costă vs. cât economisești</h2>
        <p>Calculul e simplu pentru o atracție medie cu 200-500 vizitatori zilnici care primește între 20 și 80 cereri zilnice prin formular site, mesaje Instagram și telefon.</p>

        <div class="roi-block">
          <p><strong>Cost concierge AI:</strong> 250 lei/lună (planul Standard) sau 550 lei/lună (Pro pentru muzee și destinații cu trafic mare).</p>

          <p><strong>Cost economisit lunar:</strong></p>
          <ul>
            <li>3-5 ore zilnice de timp personal informații: aproximativ 90-150 ore lunare la cost-oră de minimum 30 lei = 2700-4500 lei</li>
            <li>Reducere bariere de acces pentru turiști internaționali: estimat 5-15% creștere vizitatori străini</li>
            <li>Eliminare timpul de răspuns la formulare contact (de la zile la secunde)</li>
          </ul>

          <p><strong>Break-even tipic:</strong> 2-4 săptămâni. După aceea, fiecare vizitator suplimentar e venit net.</p>
        </div>

        <p>Pentru un muzeu cu venit lunar de peste 100.000 lei din bilete, costul concierge-ului AI reprezintă sub 1% din venituri — în schimbul unei creșteri estimate de 5-10% a vizitelor prin reducerea barierei de comunicare.</p>
      </div>
    </section>

    <section class="vert-section vert-section-alt">
      <div class="container">
        <h2>Ce face concierge-ul AI pentru atracții turistice în practică</h2>
        <p>Listă concretă de scenarii rezolvate automat de MyChatbot:</p>
        <ul class="scenarios-list">
          <li>Prezentarea programului real (orar normal, sezonier, sărbători)</li>
          <li>Răspuns la întrebări despre tarife pentru toate categoriile</li>
          <li>Informații despre audio-ghizi, ghidaje în limbi străine, durata vizitei</li>
          <li>Politica accesibilitate (cărucior, scaun rotile, animale de companie)</li>
          <li>Informații despre cum ajungi (parcare, transport public, distanțe)</li>
          <li>Sugestii pentru completarea vizitei (restaurant pe locație, alte atracții apropiate)</li>
          <li>Preluarea cererilor de rezervare pentru tururi ghidate sau evenimente private</li>
          <li>Răspuns în multe limbi pentru turiști internaționali</li>
          <li>Informații despre expoziții temporare, evenimente speciale, programe educaționale</li>
          <li>Recomandări de vizitare (cea mai bună perioadă, cât timp să aloci)</li>
          <li>Detectare automată limbă turist și răspuns în limba lor</li>
          <li>Handoff către personalul atracției pentru cazuri complexe (evenimente private, grupuri mari)</li>
        </ul>
      </div>
    </section>

    <section class="vert-section">
      <div class="container">
        <h2>Întrebări frecvente despre concierge AI pentru atracții turistice</h2>
        <div class="faq-list">
          {faqs.map((item) => (
            <details class="faq-item">
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="vert-cta-final">
      <div class="container">
        <h2>Începe cu un trial gratuit de 7 zile</h2>
        <p>Cele mai utile decizii se iau cu informații concrete. Trial-ul de 7 zile pe planul Standard îți permite să testezi cu informațiile reale ale atracției tale — fără card bancar, fără angajament. După cele 7 zile, alegi planul potrivit sau renunți.</p>
        <a href="https://app.mychatbot.ro/signup" class="btn-cta-primary">Începe trial gratuit →</a>
        <p class="cta-secondary">Pentru întrebări specifice sau o demonstrație ghidată, <a href="mailto:contact@mychatbot.ro">contactează-ne la contact@mychatbot.ro</a>.</p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .breadcrumb-nav { background: #f8fafc; padding: 14px 0; border-bottom: 1px solid #e2e8f0; font-size: 14px; }
  .breadcrumb-nav .container { max-width: 1280px; margin: 0 auto; padding: 0 24px; }
  .breadcrumb-nav a { color: #475569; text-decoration: none; }
  .breadcrumb-nav a:hover { color: #06b6d4; }
  .breadcrumb-nav .separator { margin: 0 8px; color: #94a3b8; }
  .breadcrumb-nav .current { color: #0f172a; font-weight: 600; }

  main { background: #ffffff; }
  .container { max-width: 1280px; margin: 0 auto; padding: 0 24px; }

  .vert-hero { padding: 64px 0 32px; text-align: left; }
  .vert-hero .container { max-width: 880px; }
  .section-tag { display: inline-block; background: rgba(6, 182, 212, 0.12); color: #0891b2; padding: 6px 14px; border-radius: 16px; font-size: 12px; font-weight: 700; letter-spacing: 1.5px; margin-bottom: 20px; }
  .vert-hero h1 { font-size: clamp(32px, 5vw, 52px); font-weight: 800; line-height: 1.1; color: #0f172a; margin: 0 0 24px; letter-spacing: -1px; }

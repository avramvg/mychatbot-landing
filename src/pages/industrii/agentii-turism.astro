---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const SITE_URL = 'https://www.mychatbot.ro';
const ORG_ID = `${SITE_URL}/#organization`;
const PAGE_URL = `${SITE_URL}/industrii/agentii-turism`;
const COVER_URL = `${SITE_URL}/industrii/agentii-turism-cover.svg`;

const faqs = [
  {
    q: "Confirmă concierge-ul AI rezervările pentru pachete?",
    a: "Nu. Concierge-ul AI colectează cererea clientului (destinație, perioadă, număr persoane, buget aproximativ, preferințe) și o trimite consultantului pentru ofertă personalizată sau confirmare manuală. Confirmarea rămâne o decizie umană — această alegere previne erori la prețuri (în special pentru pachete charter cu disponibilitate limitată) și permite consultantului să facă upsell pentru asigurări sau servicii premium."
  },
  {
    q: "Înțelege diferențele între pachete (all-inclusive, demi-pension, charter)?",
    a: "Da. MyChatbot e pre-antrenat pe terminologia turistică românească: all-inclusive, demi-pension, plin pension, ultra all-inclusive, soft drinks all-inclusive, charter, zbor de linie, transferuri incluse/opționale, asigurări medicale Schengen vs international. Răspunde la întrebări despre diferențele dintre pachete pe baza informațiilor reale ale agenției tale."
  },
  {
    q: "Acceptă vouchere de vacanță și informează despre acestea?",
    a: "Da. Concierge-ul AI cunoaște specificul voucherelor de vacanță din România (Up România, Edenred, Pluxee, Sodexo) și răspunde la întrebări despre acceptarea lor, valoarea maximă acceptată, combinarea cu alte mijloace de plată. Pentru cerințe specifice (verificarea unui voucher concret, depunerea fizică), redirecționează spre consultant."
  },
  {
    q: "Cum gestionează modificările last-minute?",
    a: "Modificările pentru pachete (schimbare hotel, modificare perioadă, adăugare persoane, anulare) sunt preluate automat de concierge-ul AI și trimise consultantului pentru actualizare. Pentru anulări care implică penalități (mai puțin de 30 zile până la plecare), concierge-ul informează clientul despre politica agenției și politica tour operatorului charter (dacă e cazul) și transferă conversația către consultant pentru detalii exacte."
  },
  {
    q: "Răspunde în limbi străine pentru turiștii internaționali?",
    a: "Da. Concierge-ul AI răspunde nativ în 50+ limbi, detectând automat limba mesajului. Pentru tour operatorii care vând tururi în România către turiști internaționali, concierge-ul răspunde la întrebări despre tururi, prețuri, durata, ce include — în limba turistului. Pentru agențiile care primesc cereri de la români cu nevoia de informații în engleză (formular în engleză), concierge-ul detectează și răspunde corespunzător."
  },
  {
    q: "Sunt datele clienților protejate conform GDPR?",
    a: "Da. MyChatbot procesează datele exclusiv pe servere UE (Frankfurt) și nu păstrează conținutul conversațiilor mai mult decât e necesar pentru funcționare. Acordul de procesare a datelor (DPA) este disponibil în limba română și conform Regulamentului UE 2016/679. Pentru date sensibile (paspoarte, asigurări medicale), concierge-ul nu colectează aceste informații direct — redirecționează către consultant pentru handling securizat."
  },
  {
    q: "Pot configura informațiile despre tururile proprii?",
    a: "Da. Pentru tour operatorii care creează tururi proprii (city tours, circuite, tururi tematice), MyChatbot permite configurarea fiecărui tur cu detalii: traseu, durată, ce include (ghid, transfer, mese), prețuri, perioade disponibile, limbi în care e oferit. Concierge-ul răspunde apoi la întrebări specifice pentru fiecare tur, în limba clientului."
  },
  {
    q: "Cum se integrează cu sistemul de booking?",
    a: "Pentru agențiile care folosesc sisteme proprii de booking, concierge-ul AI poate verifica disponibilitatea în timp real prin integrare iCal (planul Standard în sus). Pentru agențiile fără sistem online, concierge-ul colectează cererile și le trimite consultanților pentru verificare manuală a disponibilității la furnizori."
  }
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Concierge AI pentru agenții de turism și tour operatori",
  "description": "Concierge AI specializat pentru agenții turism și tour operatori. Răspunde 24/7 la întrebări despre pachete, destinații, prețuri și documentație de călătorie — în 50+ limbi.",
  "url": PAGE_URL,
  "image": COVER_URL,
  "provider": { "@id": ORG_ID },
  "areaServed": { "@type": "Country", "name": "Romania" },
  "serviceType": "AI Customer Service for Travel Agencies",
  "category": "Travel Technology",
  "audience": {
    "@type": "BusinessAudience",
    "audienceType": "Travel Agencies, Tour Operators"
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Acasă", "item": SITE_URL },
    { "@type": "ListItem", "position": 2, "name": "Industrii", "item": `${SITE_URL}/industrii` },
    { "@type": "ListItem", "position": 3, "name": "Agenții turism", "item": PAGE_URL }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": { "@type": "Answer", "text": item.a }
  }))
};
---

<Layout
  title="Concierge AI pentru agenții de turism și tour operatori — MyChatbot"
  description="Concierge AI specializat pentru agenții turism și tour operatori. Răspunde 24/7 la întrebări despre pachete, destinații, prețuri și documentație de călătorie."
  canonical={PAGE_URL}
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <Nav basePath="/" />

  <main>
    <nav class="breadcrumb-nav" aria-label="breadcrumb">
      <div class="container">
        <a href="/">Acasă</a>
        <span class="separator">›</span>
        <a href="/industrii/">Industrii</a>
        <span class="separator">›</span>
        <span class="current">Agenții turism</span>
      </div>
    </nav>

    <section class="vert-hero">
      <div class="container">
        <span class="section-tag">VERTICALA · AGENȚII TURISM</span>
        <h1>Concierge AI pentru agenții de turism și tour operatori</h1>
        <p class="lead">De la agenții de turism cu 1-2 oameni la tour operatori cu zeci de tururi proprii, un concierge AI răspunde 24/7 la întrebări despre pachete, destinații, prețuri și documentație de călătorie — exact când clientul caută. Pentru agențiile din România, e diferența între a închide vânzarea miercuri seara și a pierde clientul către un competitor care a răspuns mai rapid.</p>
        <p>În 2026, deciziile de cumpărare pentru pachete turistice se iau în mare parte online — clientul compară 3-5 oferte, citește reviews, întreabă în chat. Agenția care răspunde primul cu informații concrete și relevante câștigă. Agenția care lasă cererea în așteptare până dimineață pierde 30-40% din potențiali clienți.</p>
        <div class="hero-img-wrapper">
          <img src="/industrii/agentii-turism-cover.svg" alt="Concierge AI pentru agenții de turism și tour operatori" width="1200" height="630" />
        </div>
      </div>
    </section>

    <section class="vert-section">
      <div class="container">
        <h2>Pentru cine este concierge-ul AI MyChatbot</h2>
        <p>MyChatbot acoperă tot range-ul afacerilor de turism — de la agenții independente cu 1-2 angajați, la agenții medii care vând pachete pentru toate destinațiile populare, până la tour operatori cu portofoliu propriu de tururi. Logica de bază e aceeași: răspunsuri instant cu informații despre pachete, destinații, prețuri și documentație. Diferența între planuri stă în volumul de conversații și complexitatea integrărilor cu sistemele de booking.</p>

        <div class="subverticals-grid">
          <article class="subvert-card">
            <div class="plan-badge plan-start">PLAN START · 150 lei/lună</div>
            <h3>Agenții de turism mici și sezoniere</h3>
            <p>Pentru agențiile cu 1-2 angajați și activitate sezonieră (sezon mai-septembrie pentru litoral și septembrie-mai pentru ski), concierge-ul AI Start răspunde automat la întrebările repetitive: ce pachete sunt disponibile pentru weekend-ul următor, ce include prețul, dacă voucherele de vacanță sunt acceptate, modalitățile de plată. Setup-ul durează sub o oră și include trial gratuit 7 zile pe planul Standard.</p>
            <p>Avantajul concret: o agenție mică cu un singur agent recuperează 1-2 ore zilnic — timp care altfel ar fi consumat pe răspunsuri identice către clienți care întreabă aceleași lucruri despre Halkidiki, Sunny Beach sau Antalya.</p>
          </article>

          <article class="subvert-card">
            <div class="plan-badge plan-standard">PLAN STANDARD · 250 lei/lună</div>
            <h3>Agenții de turism medii și active tot anul</h3>
            <p>Pentru agențiile cu 3-10 angajați și activitate constantă, concierge-ul AI Standard gestionează volumul mai mare de cereri și include verificare disponibilitate prin iCal pentru pachetele agenției. Răspunde la întrebări complexe despre pachete personalizate ("vreau Grecia 7 nopți, hotel 4*, all-inclusive, cu 2 copii sub 12 ani"), preia cererile pentru ofertă personalizată și redirecționează spre consultantul de călătorii pentru cazuri ce necesită atenție directă.</p>
            <p>Pentru agențiile cu trafic web mediu (50-200 vizitatori/zi în sezon), concierge-ul AI captează cererile care vin în afara orelor de program și le pregătește pentru consultanți a doua zi dimineață — niciun client nu pleacă cu impresia că agenția nu răspunde.</p>
          </article>

          <article class="subvert-card">
            <div class="plan-badge plan-pro">PLAN PRO · 550 lei/lună</div>
            <h3>Tour operatori cu portofoliu propriu</h3>
            <p>Pentru tour operatorii care creează și operează tururi proprii — city tours București/Brașov/Sibiu, circuite turistice România, charter Grecia/Bulgaria/Turcia, tururi tematice (medieval, gastronomic, vânătoare) — concierge-ul AI Pro gestionează zeci de cereri simultane în mai multe limbi, sincronizează disponibilitatea pe toate tururile, integrează cu sistemul de booking propriu și produce rapoarte detaliate.</p>
            <p>Pentru tour operatorii cu trafic internațional (turiști din Israel, Germania, Franța, Italia, SUA care caută tururi în România), capacitatea de a răspunde nativ în 50+ limbi e critică. Multe vânzări se pierd la barieră lingvistică — un concierge AI elimină acest obstacol.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="vert-section">
      <div class="container">
        <h2>Cum ajută concierge AI o agenție de turism sau tour operator</h2>
        <p>Patru probleme tipice și soluțiile concrete oferite de un concierge AI specializat HoReCa.</p>

        <div class="problem-block">
          <h3>Volumul de cereri în sezonul de vârf</h3>
          <p>Mai-iunie pentru pachete vară, octombrie-noiembrie pentru sezonul ski, decembrie pentru Revelion. În aceste luni, agențiile primesc volume de cereri online care depășesc capacitatea oamenilor disponibili. Telefonul sună constant, mesajele pe Instagram și WhatsApp se acumulează, formularele de contact rămân fără răspuns ore bune.</p>
          <p>Cu concierge AI, vizitatorul primește răspuns instant la 22:00 cu informații despre pachetele disponibile, prețuri, ce include, ce nu include, modalitățile de plată. Cererile complexe sunt structurate și trimise consultanților pentru ofertă personalizată în dimineața următoare — fără ca potențialul client să simtă că nimeni nu i-a răspuns.</p>
        </div>

        <div class="problem-block">
          <h3>Întrebările identice repetate de zeci de ori pe zi</h3>
          <p>"Ce include pachetul?", "Zborul e inclus?", "Transferurile sunt incluse?", "Asigurarea medicală?", "Ce hoteluri sunt disponibile?", "Acceptați vouchere de vacanță?", "Plata se face în rate?", "Care e politica de anulare?". Aceleași întrebări, în fiecare zi, primesc același răspuns — dar consumă timp prețios al consultanților de călătorii care ar trebui să se concentreze pe vânzări consultative.</p>
          <p>Concierge-ul AI răspunde instant pe baza informațiilor reale despre pachete, eliberând consultanții pentru interacțiuni cu valoare reală: oferte personalizate, gestionarea modificărilor, urmărirea clienților VIP, vânzări upsell pentru asigurări sau experiențe suplimentare.</p>
        </div>

        <div class="problem-block">
          <h3>Bariera lingvistică pentru turiști internaționali</h3>
          <p>Pentru tour operatorii care vând tururi în România către turiști internaționali, sau pentru agențiile care vând pachete în Grecia/Bulgaria/Turcia către clienți din România cu nevoia de informații în engleză sau alte limbi, traducerea consumă timp și introduce erori. Un site bilingv parțial sau un personal care nu vorbește toate limbile creează o experiență fragmentată.</p>
          <p>Concierge-ul AI detectează automat limba mesajului și răspunde nativ în 50+ limbi cu informațiile reale despre pachete și destinații. Pentru un turist american care caută tour în Transilvania sau un german care vrea informații despre charter în Halkidiki, răspunsul vine instant în limba lor — natural, idiomatic.</p>
        </div>

        <div class="problem-block">
          <h3>Documentația de călătorie — paspoarte, vize, asigurări</h3>
          <p>Întrebările despre documentația necesară pentru fiecare destinație consumă timp disproporționat. "Am nevoie de viză pentru Turcia?", "Câte luni trebuie să fie valabil pașaportul?", "Asigurarea medicală e obligatorie?", "Ce vaccinuri trebuie pentru Egipt?", "Pot călători cu copilul fără un părinte?". Răspunsurile diferă pe destinație și pe situații specifice (cetățenie, vârstă, perioadă).</p>
          <p>Concierge-ul AI răspunde instant cu informații actualizate despre cerințele de călătorie pentru fiecare destinație. Pentru cazuri specifice sau modificări recente, transferă conversația către consultant. Niciun consultant nu ar trebui să-și petreacă timp explicând de zeci de ori că pașaportul trebuie să fie valabil 6 luni de la data întoarcerii.</p>
        </div>
      </div>
    </section>

    <section class="vert-section vert-section-alt">
      <div class="container">
        <h2>Concierge AI specializat vs. chatbot generic — comparație pentru agenții turism</h2>
        <p>Diferența nu e doar de preț, ci de înțelegere a contextului turistic. Un chatbot generic nu cunoaște diferența între pachet "all-inclusive" și "demipensiune", nu știe ce înseamnă charter vs zbor de linie, nu poate explica regulamentul de bagaje pe diferite companii aeriene. Un concierge AI specializat MyChatbot pleacă cu acest context preinstalat.</p>

        <div class="comparison-table-wrapper">
          <table class="comparison-table">
            <thead>
              <tr><th>Criteriu</th><th>Chatbot generic</th><th>MyChatbot pentru agenții turism</th></tr>
            </thead>
            <tbody>
              <tr><td>Cunoaștere domeniu turism</td><td>Generală, learn from scratch</td><td>Pre-antrenat pe scenarii agenții</td></tr>
              <tr><td>Limba română</td><td>Variabilă, traducere</td><td>Nativă, idiomatică</td></tr>
              <tr><td>Înțelegere pachete turistice</td><td>Slabă</td><td>Cunoaște all-inclusive, charter, demi-pension, transferuri</td></tr>
              <tr><td>Suport în română</td><td>Rar</td><td>Standard, în 5 minute</td></tr>
              <tr><td>Conformitate GDPR-RO</td><td>Generică</td><td>Server UE, DPA în română</td></tr>
              <tr><td>Vouchere de vacanță</td><td>Nu cunoaște</td><td>Cunoaște specificul român (Up România, etc.)</td></tr>
              <tr><td>Tonalitate adaptată</td><td>Generic</td><td>Prietenos pentru agenții, profesional pentru tour operatori</td></tr>
              <tr><td>Setup pentru agenție mică</td><td>Configurare extinsă</td><td>Sub o oră, fără cunoștințe tehnice</td></tr>
              <tr><td>Preț pentru agenție mică</td><td>100-500 EUR/lună</td><td>30 EUR/lună (150 lei)</td></tr>
            </tbody>
          </table>
        </div>

        <p>Pentru un proprietar de agenție fără echipă tehnică, diferența practică se vede în primele 30 de minute. Un chatbot generic îi cere să configureze de la zero ce înseamnă "pachet charter cu transferuri incluse". MyChatbot știe deja aceste concepte și se concentrează pe particularitățile portofoliului tău de pachete.</p>
      </div>
    </section>

    <section class="vert-section">
      <div class="container">
        <h2>ROI: cât costă vs. cât economisești</h2>
        <p>Calculul e simplu pentru o agenție medie cu 3-5 angajați care primește între 15 și 50 cereri zilnice prin formular site, mesaje Instagram, WhatsApp și cereri prin Booking.</p>

        <div class="roi-block">
          <p><strong>Cost concierge AI:</strong> 250 lei/lună (planul Standard) sau 550 lei/lună (Pro pentru tour operatori).</p>

          <p><strong>Cost economisit lunar:</strong></p>
          <ul>
            <li>3-5 ore zilnice de timp consultant: aproximativ 90-150 ore lunare la cost-oră de minimum 40 lei = 3600-6000 lei</li>
            <li>2-5 vânzări recuperate la valori medii de 1500-4000 lei/pachet din cereri ce s-ar fi pierdut după ore = 3000-20000 lei/lună</li>
            <li>Conversie crescută prin răspuns instant (clientul nu mai compară cu alți 3 furnizori cât așteaptă)</li>
          </ul>

          <p><strong>Break-even tipic:</strong> prima vânzare suplimentară din lună. Pentru tour operatori, ROI-ul e atins în prima săptămână.</p>
        </div>

        <p>Pentru un tour operator cu cifră de afaceri lunară de peste 100.000 lei, costul concierge-ului AI reprezintă sub 1% din venituri — în schimbul unei creșteri estimate de 5-15% a conversiei prin răspuns rapid.</p>
      </div>
    </section>

    <section class="vert-section vert-section-alt">
      <div class="container">
        <h2>Ce face concierge-ul AI pentru agenții turism în practică</h2>
        <p>Listă concretă de scenarii rezolvate automat de MyChatbot:</p>
        <ul class="scenarios-list">
          <li>Prezentarea pachetelor disponibile pe destinație, perioadă, buget</li>
          <li>Răspuns la întrebări despre ce include și ce nu include un pachet</li>
          <li>Informații despre hoteluri, transferuri, regimuri de masă</li>
          <li>Politica de anulare, asigurări de călătorie, modalități de plată</li>
          <li>Informații despre documentație (paspoarte, vize, asigurări medicale)</li>
          <li>Răspuns la întrebări despre vouchere de vacanță (Up România, Edenred etc.)</li>
          <li>Preluarea cererilor pentru ofertă personalizată</li>
          <li>Recomandări de destinații în funcție de buget, sezon, tip vacanță</li>
          <li>Informații despre tururi proprii (city tours, circuite, tururi tematice)</li>
          <li>Detectare automată limbă client și răspuns în limba lor</li>
          <li>Handoff către consultant pentru cazuri complexe</li>
          <li>Sugestii de upsell (asigurări, transferuri premium, experiențe suplimentare)</li>
        </ul>
      </div>
    </section>

    <section class="vert-section">
      <div class="container">
        <h2>Întrebări frecvente despre concierge AI pentru agenții turism</h2>
        <div class="faq-list">
          {faqs.map((item) => (
            <details class="faq-item">
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="vert-cta-final">
      <div class="container">
        <h2>Începe cu un trial gratuit de 7 zile</h2>
        <p>Cele mai utile decizii se iau cu informații concrete. Trial-ul de 7 zile pe planul Standard îți permite să testezi cu portofoliul real de pachete al agenției tale — fără card bancar, fără angajament. După cele 7 zile, alegi planul potrivit sau renunți.</p>
        <a href="https://app.mychatbot.ro/signup" class="btn-cta-primary">Începe trial gratuit →</a>
        <p class="cta-secondary">Pentru întrebări specifice sau o demonstrație ghidată, <a href="mailto:contact@mychatbot.ro">contactează-ne la contact@mychatbot.ro</a>.</p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .breadcrumb-nav { background: #f8fafc; padding: 14px 0; border-bottom: 1px solid #e2e8f0; font-size: 14px; }
  .breadcrumb-nav .container { max-width: 1280px; margin: 0 auto; padding: 0 24px; }
  .breadcrumb-nav a { color: #475569; text-decoration: none; }
  .breadcrumb-nav a:hover { color: #06b6d4; }
  .breadcrumb-nav .separator { margin: 0 8px; color: #94a3b8; }
  .breadcrumb-nav .current { color: #0f172a; font-weight: 600; }

  main { background: #ffffff; }
  .container { max-width: 1280px; margin: 0 auto; padding: 0 24px; }

  .vert-hero { padding: 64px 0 32px; text-align: left; }
  .vert-hero .container { max-width: 880px; }
  .section-tag { display: inline-block; background: rgba(6, 182, 212, 0.12); color: #0891b2; padding: 6px 14px; border-radius: 16px; font-size: 12px; font-weight: 700; letter-spacing: 1.5px; margin-bottom: 20px; }
  .vert-hero h1 { font-size: clamp(32px, 5vw, 52px); font-weight: 800; line-height: 1.1; color: #0f172a; margin: 0 0 24px; letter-spacing: -1px; }
  .vert-hero .lead { font-size: 20px; line-height: 1.6; color: #334155; margin-bottom: 20px; }
  .vert-hero p { font-size: 17px; line-height: 1.7; color: #475569; margin-bottom: 16px; }
  .hero-img-wrapper { margin-top: 40px; border-radius: 12px; overflow: hidden; }
  .hero-img-wrapper img { width: 100%; height: auto; display: block; }

  .vert-section { padding: 56px 0; }
  .vert-section-alt { background: #f8fafc; }
  .vert-section .container { max-width: 880px; }

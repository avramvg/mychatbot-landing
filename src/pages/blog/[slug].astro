---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, getEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props:  { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const dateStr = post.data.pubDate.toLocaleDateString('ro-RO', {
  day: 'numeric', month: 'long', year: 'numeric',
});

const canonical = `https://www.mychatbot.ro/blog/${post.slug}`;
---

<Layout
  title={`${post.data.title} — MyChatbot Blog`}
  description={post.data.description}
  canonical={canonical}
>
  <Nav basePath="/" />
  <main>

    {/* ── Hero articol ── */}
    <section class="art-hero">
      <div class="container art-hero-inner">
        <div class="art-meta-top">
          <a href="/blog" class="art-back">← Blog</a>
          <div class="art-tags">
            {post.data.tags.map((tag) => (
              <span class="art-tag">{tag}</span>
            ))}
          </div>
        </div>
        <h1>{post.data.title}</h1>
        <p class="art-desc">{post.data.description}</p>
        <div class="art-byline">
          <span class="art-author">{post.data.author}</span>
          <span class="art-sep">·</span>
          <span class="art-date">{dateStr}</span>
        </div>
      </div>
    </section>

    {post.data.image && (
      <div class="article-hero-img">
        <img
          src={post.data.image}
          alt={post.data.imageAlt || post.data.title}
          width="800"
          height="400"
          style="width:100%;max-width:720px;height:auto;border-radius:12px;margin-bottom:2rem;display:block;margin-left:auto;margin-right:auto;"
        />
      </div>
    )}

    {/* ── Conținut articol ── */}
    <div class="art-body-wrap">
      <article class="art-body prose">
        <Content />
      </article>
    </div>

    {/* ── CTA inline ── */}
    <section class="art-cta-final">
      <div class="container art-cta-inner">
        <h2>Încearcă MyChatbot gratuit 7 zile</h2>
        <p>Fără card de credit · Configurare în 10 minute · Anulezi oricând</p>
        <a href="https://app.mychatbot.ro/signup" class="btn-primary">
          Începe trial gratuit →
        </a>
      </div>
    </section>

  </main>
  <Footer />
</Layout>

<style>
  /* ── Hero ── */
  .art-hero {
    padding: 3rem 0 2rem;
    border-bottom: none;
  }
  .art-hero-inner {
    max-width: 760px;
    margin: 0 auto;
  }
  .art-meta-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .art-back {
    font-size: 13px;
    color: var(--color-slate);
    text-decoration: none;
    transition: color 0.15s;
  }
  .art-back:hover { color: var(--color-dark); }
  .art-tags { display: flex; gap: 6px; }
  .art-tag {
    font-size: 11px;
    font-weight: 600;
    color: var(--color-primary);
    background: #e0f2fe;
    padding: 2px 10px;
    border-radius: 20px;
  }

  .art-hero h1 {
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    line-height: 1.3;
    margin-bottom: 1rem;
    color: var(--color-dark);
  }
  .art-desc {
    font-size: 1.05rem;
    color: var(--color-slate);
    line-height: 1.7;
    margin-bottom: 1.25rem;
  }
  .art-byline {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: #94a3b8;
  }
  .art-author { font-weight: 600; color: var(--color-slate); }
  .art-sep    { color: #cbd5e1; }

  /* ── Imagine ── */
  .art-img-wrap {
    max-width: 760px;
    margin: 0 auto 0;
    padding: 0 1.5rem;
  }
  .art-img {
    width: 100%;
    border-radius: 14px;
    aspect-ratio: 16/9;
    object-fit: cover;
    background: #f1f5f9;
    display: block;
  }

  /* ── Body / Prose ── */
  .art-body-wrap {
    padding: 2.5rem 0 3rem;
    border-bottom: 0.5px solid var(--color-border);
  }
  .art-body {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Prose styles */
  .prose :global(h2) {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-dark);
    margin: 2.25rem 0 0.75rem;
    padding-bottom: 0.4rem;
    border-bottom: 0.5px solid var(--color-border);
  }
  .prose :global(h3) {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-dark);
    margin: 1.5rem 0 0.5rem;
  }
  .prose :global(p) {
    font-size: 0.97rem;
    color: #334155;
    line-height: 1.8;
    margin-bottom: 1.1rem;
  }
  .prose :global(ul), .prose :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.1rem;
  }
  .prose :global(li) {
    font-size: 0.97rem;
    color: #334155;
    line-height: 1.75;
    margin-bottom: 0.3rem;
  }
  .prose :global(strong) {
    color: var(--color-dark);
    font-weight: 700;
  }
  .prose :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose :global(a:hover) {
    color: var(--color-primary-dark);
  }
  .prose :global(blockquote) {
    border-left: 3px solid var(--color-primary);
    padding-left: 1rem;
    margin: 1.5rem 0;
    font-style: italic;
    color: var(--color-slate);
  }
  .prose :global(hr) {
    border: none;
    border-top: 0.5px solid var(--color-border);
    margin: 2rem 0;
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
    margin-bottom: 1.5rem;
  }
  .prose :global(th) {
    background: #f8fafc;
    padding: 8px 12px;
    text-align: left;
    font-weight: 600;
    color: var(--color-dark);
    border: 0.5px solid var(--color-border);
  }
  .prose :global(td) {
    padding: 8px 12px;
    border: 0.5px solid var(--color-border);
    color: #475569;
  }

  /* ── CTA final ── */
  .art-cta-final {
    background: #0f172a;
    padding: 4rem 0;
    text-align: center;
    border-bottom: none;
  }
  .art-cta-inner h2 {
    color: white;
    font-size: clamp(1.3rem, 3vw, 1.8rem);
    margin-bottom: 0.75rem;
  }
  .art-cta-inner p {
    color: rgba(255,255,255,0.6);
    font-size: 0.9rem;
    margin-bottom: 1.75rem;
  }
</style>

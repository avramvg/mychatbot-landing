---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const industries = [
  {
    title: 'Unități de cazare',
    popular: true,
    link: '/industrii/hoteluri/',
    svg: '<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>',
    bullets: [
      'Rezervări camere cu verificare disponibilitate iCal',
      'Program mic dejun, check-in/check-out, servicii incluse',
      'Pachete excursii și activități recomandate în zonă',
    ],
  },
  {
    title: 'Restaurante & Cafenele',
    popular: false,
    svg: '<path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/>',
    bullets: [
      'Rezervări masă cu colectare date (data, ora, persoane)',
      'Meniu zilnic, speciale și evenimente de seară',
      'Program de funcționare și politică rezervări',
    ],
  },
  {
    title: 'Agenții și Touroperatori',
    popular: false,
    svg: '<circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>',
    bullets: [
      'Pachete vacanță - excursii, tururi, destinații, prețuri',
      'Cerere ofertă personalizată cu colectare date',
      'Informații servicii adiționale -exp. transfer, asigurare de călătorie',
    ],
  },
  {
    title: 'Cabinete medicale și stomatologice',
    popular: false,
    svg: '<path d="M22 12h-4l-3 9L9 3l-3 9H2"/>',
    bullets: [
      'Programări online cu specificarea serviciului dorit',
      'Lista servicii, prețuri consultații și investigații',
      'Urgențe — protocol și număr de contact rapid',
    ],
  },
  {
    title: 'Saloane Wellness & Beauty',
    popular: false,
    svg: '<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>',
    bullets: [
      'Programări salon — servicii disponibile și personal',
      'Prețuri tratamente, pachete și abonamente',
      'Politică anulare și reprogramare',
    ],
  },
  {
    title: 'Agenții imobiliare',
    popular: false,
    svg: '<rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>',
    bullets: [
      'Proprietăți disponibile — filtrare după zonă și preț',
      'Programare vizionare cu colectare date contact',
      'Informații credit ipotecar și evaluare proprietate',
    ],
  },
  {
    title: 'Retail & Magazine',
    popular: false,
    svg: '<circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>',
    bullets: [
      'Program, locație și informații despre produse',
      'Comenzi online — status și politică retur',
      'Stoc disponibil și notificări reaprovizionare',
    ],
  },
  {
    title: 'Educație & Cursuri',
    popular: false,
    svg: '<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>',
    bullets: [
      'Înscrieri la cursuri cu colectare date și nivel',
      'Program, taxe, profesori și structura cursului',
      'Certificare, acreditare și recunoaștere diplome',
    ],
  },
  {
    title: 'Auto & Service',
    popular: false,
    svg: '<rect x="1" y="3" width="15" height="13" rx="2"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>',
    bullets: [
      'Programări service cu specificarea problemei',
      'Piese disponibile — interogare stoc și prețuri',
      'Timp estimat reparație și informații complete',
    ],
  },
];
---

<Layout
  title="Industrii — MyChatbot"
  description="MyChatbot funcționează pentru orice business cu clienți online — HoReCa, restaurante, turism, medical, beauty, imobiliare și multe altele."
  canonical="https://www.mychatbot.ro/industrii"
>
  <Nav basePath="/" />
  <main>

    {/* ── Hero ── */}
    <section class="ind-hero">
      <div class="container">
        <span class="section-tag">Soluții</span>
        <h1>Chatbot AI pentru orice industrie</h1>
        <p class="ind-hero-sub">
          Configurat specific pentru afacerea ta — nu un chatbot generic,
          ci unul care știe exact ce întreabă clienții tăi.
        </p>
      </div>
    </section>

    {/* ── Grid 3×3 ── */}
    <section class="ind-section">
      <div class="container">
        <div class="ind-grid">
          {industries.map((ind) => {
            const card = (
              <div class={`ind-card ${ind.popular ? 'ind-card--popular' : ''}`}>
                {ind.popular && <div class="ind-popular-badge">⭐ Popular</div>}
                <div class="ind-icon-wrap">
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none"
                       stroke="currentColor" stroke-width="1.75"
                       stroke-linecap="round" stroke-linejoin="round"
                       set:html={ind.svg} />
                </div>
                <h3 class="ind-title">{ind.title}</h3>
                <ul class="ind-bullets">
                  {ind.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
              </div>
            );
            return ind.link
              ? <a href={ind.link} class="ind-card-link">{card}</a>
              : card;
          })}
        </div>

        {/* ── CTA sub grid ── */}
        <div class="ind-footer-cta">
          <p class="ind-footer-text">
            Nu găsești industria ta?
            <strong> MyChatbot funcționează pentru orice business cu clienți online.</strong>
          </p>
          <a href="mailto:hello@helloweb.ro" class="btn-secondary ind-contact-btn">
            Contactează-ne →
          </a>
        </div>

      </div>
    </section>

    {/* ── CTA final ── */}
    <section class="ind-cta-final">
      <div class="container ind-cta-inner">
        <h2>Gata să îți automatizezi suportul?</h2>
        <p>7 zile gratuit · Fără card de credit · Configurare în 10 minute</p>
        <a href="https://app.mychatbot.ro/signup" class="btn-primary">
          Începe trial gratuit →
        </a>
      </div>
    </section>

  </main>
  <Footer />
</Layout>

<style>
  /* ── Hero ── */
  .ind-hero {
    padding: 4rem 0 2.5rem;
    border-bottom: 0.5px solid var(--color-border);
    text-align: center;
  }
  .ind-hero h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin-bottom: 1rem;
  }
  .ind-hero-sub {
    font-size: 1.05rem;
    color: var(--color-slate);
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.7;
  }

  /* ── Grid section ── */
  .ind-section {
    padding: 3rem 0 4rem;
  }
  .ind-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-bottom: 3rem;
  }

  /* ── Card link wrapper ── */
  .ind-card-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .ind-card-link:hover .ind-card {
    border-color: #06b6d4;
    box-shadow: 0 8px 24px rgba(6, 182, 212, 0.15);
  }

  /* ── Card ── */
  .ind-card {
    background: #fff;
    border: 0.5px solid var(--color-border);
    border-radius: 14px;
    padding: 1.5rem;
    position: relative;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .ind-card:hover {
    box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    transform: translateY(-2px);
  }
  .ind-card--popular {
    border-color: #2563eb;
    box-shadow: 0 0 0 1px #2563eb;
  }

  /* ── Popular badge ── */
  .ind-popular-badge {
    position: absolute;
    top: -11px;
    left: 1.25rem;
    background: #2563eb;
    color: white;
    font-size: 11px;
    font-weight: 600;
    padding: 2px 10px;
    border-radius: 20px;
    letter-spacing: 0.3px;
  }

  /* ── Icon ── */
  .ind-icon-wrap {
    width: 52px;
    height: 52px;
    background: #eff6ff;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #2563eb;
    margin-bottom: 1rem;
  }
  .ind-card--popular .ind-icon-wrap {
    background: #dbeafe;
  }

  /* ── Title ── */
  .ind-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-dark);
    margin-bottom: 0.75rem;
  }

  /* ── Bullets ── */
  .ind-bullets {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .ind-bullets li {
    font-size: 0.8rem;
    color: var(--color-slate);
    line-height: 1.5;
    padding-left: 1.1rem;
    position: relative;
  }
  .ind-bullets li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: #2563eb;
    font-size: 0.7rem;
    top: 0.15rem;
  }

  /* ── Footer CTA ── */
  .ind-footer-cta {
    text-align: center;
    padding: 2rem;
    background: #f8fafc;
    border: 0.5px solid var(--color-border);
    border-radius: 14px;
  }
  .ind-footer-text {
    font-size: 0.95rem;
    color: var(--color-slate);
    margin-bottom: 1rem;
  }
  .ind-contact-btn {
    display: inline-block;
    padding: 10px 24px;
    font-size: 0.9rem;
    font-weight: 600;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.15s;
  }

  /* ── CTA final ── */
  .ind-cta-final {
    background: #0f172a;
    padding: 4rem 0;
    text-align: center;
  }
  .ind-cta-inner h2 {
    color: white;
    font-size: clamp(1.4rem, 3vw, 2rem);
    margin-bottom: 0.75rem;
  }
  .ind-cta-inner p {
    color: rgba(255,255,255,0.6);
    font-size: 0.9rem;
    margin-bottom: 1.75rem;
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .ind-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .ind-grid { grid-template-columns: 1fr; }
    .ind-hero { padding: 2.5rem 0 2rem; }
  }
</style>

---
const year = new Date().getFullYear();
---
<footer class="dark-footer">
  <div class="container footer-inner">
    <div>
      <div class="footer-brand">MyChatbot · by Hello Web</div>
      <div class="footer-copy">© {year} Hello Web SRL · Toate drepturile rezervate</div>
      <div class="footer-phone">+40 720 891 800</div>
    </div>
    <div class="footer-links">
      <a href="/termeni">Termeni</a>
      <a href="/confidentialitate">Confidențialitate</a>
      <a href="mailto:hello@helloweb.ro">hello@helloweb.ro</a>
    </div>
  </div>
</footer>

<style>
  .dark-footer {
    background: #0f172a;
    border-top: none;
    padding: 2rem 0 1.5rem;
  }
  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .footer-brand { font-size: 13px; font-weight: 500; color: white; }
  .footer-copy  { font-size: 11px; color: rgba(255,255,255,0.5); margin-top: 2px; }
  .footer-phone { font-size: 11px; color: rgba(255,255,255,0.5); margin-top: 2px; }
  .footer-links { display: flex; gap: 1.5rem; }
  .footer-links a {
    font-size: 12px;
    color: rgba(255,255,255,0.6);
    text-decoration: none;
    transition: color 0.15s;
  }
  .footer-links a:hover { color: white; }
</style>

---
const year = new Date().getFullYear();
---
<footer>
  <div class="container footer-inner">
    <div>
      <div class="footer-brand">MyChatbot · by Hello Web</div>
      <div class="footer-copy">© {year} Hello Web SRL · Toate drepturile rezervate</div>
    </div>
    <div class="footer-links">
      <a href="/termeni">Termeni</a>
      <a href="/confidentialitate">Confidențialitate</a>
      <a href="mailto:hello@helloweb.ro">hello@helloweb.ro</a>
    </div>
  </div>
</footer>

<style>
  footer {
    padding: 2rem 0 1.5rem;
    border-top: 0.5px solid var(--color-border);
  }
  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .footer-brand { font-size: 13px; font-weight: 500; color: var(--color-dark); }
  .footer-copy  { font-size: 11px; color: var(--color-slate); margin-top: 2px; }
  .footer-links { display: flex; gap: 1.5rem; }
  .footer-links a {
    font-size: 12px;
    color: var(--color-slate);
    text-decoration: none;
    transition: color 0.15s;
  }
  .footer-links a:hover { color: var(--color-dark); }
</style>

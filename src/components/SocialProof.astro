---
---
<section class="sp-section">
  <div class="container">
    <div class="sp-grid">

      <div class="sp-card">
        <div class="sp-icon" style="background:#eff6ff;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
        </div>
        <div class="sp-number">7 din 10</div>
        <div class="sp-text">vizitatori preferă răspuns instant față de a aștepta un email</div>
      </div>

      <div class="sp-card sp-card--accent">
        <div class="sp-icon" style="background:rgba(255,255,255,0.15);">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
        </div>
        <div class="sp-number">24/7</div>
        <div class="sp-text">activ non-stop — răspunde și când tu nu poți</div>
      </div>

      <div class="sp-card">
        <div class="sp-icon" style="background:#f0fdf4;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2">
            <polyline points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
          </svg>
        </div>
        <div class="sp-number">10 minute</div>
        <div class="sp-text">de la înregistrare la chatbot live pe site-ul tău</div>
      </div>

    </div>
  </div>
</section>

<style>
.sp-section {
  background: #f8fafc;
  padding: 2rem 0;
  border-bottom: 1px solid #e2e8f0;
}
.sp-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}
.sp-card {
  background: white;
  border: 0.5px solid #e2e8f0;
  border-radius: 12px;
  padding: 1.25rem 1.5rem;
  text-align: center;
}
.sp-card--accent {
  background: #2563eb;
  border-color: #2563eb;
}
.sp-card--accent .sp-number,
.sp-card--accent .sp-text { color: white; }
.sp-icon {
  width: 48px; height: 48px;
  border-radius: 12px;
  display: flex; align-items: center; justify-content: center;
  margin: 0 auto 12px;
}
.sp-number {
  font-size: 1.75rem;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 6px;
}
.sp-text {
  font-size: 0.875rem;
  color: #64748b;
  line-height: 1.5;
}
@media (max-width: 768px) {
  .sp-grid { grid-template-columns: 1fr; }
}
</style>

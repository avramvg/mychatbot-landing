---
// TrustBadges.astro
//
// 4 carduri trust signals — răspunde la obiecțiile de siguranță & risk.
// Plasare: imediat după IntegrationsStrip, înainte de FounderQuote.
// Rol: trust profund — ce te protejează ca proprietar HoReCa.
---

<section class="tb" aria-label="Garanții de siguranță">
  <div class="tb-container">
    <h2 class="tb-heading">Construit pentru încredere</h2>
    <p class="tb-subheading">
      Alegere sigură pentru proprietari de pensiuni, hoteluri și restaurante din România.
    </p>

    <div class="tb-grid">
      <!-- Card 1: GDPR -->
      <div class="tb-card">
        <div class="tb-icon-wrap tb-icon--shield">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <path d="m9 12 2 2 4-4"/>
          </svg>
        </div>
        <h3 class="tb-title">GDPR complet</h3>
        <p class="tb-text">
          Conformitate UE și legislația din România. Datele oaspeților protejate prin design.
        </p>
      </div>

      <!-- Card 2: Server UE -->
      <div class="tb-card">
        <div class="tb-icon-wrap tb-icon--eu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="4" width="20" height="16" rx="2"/>
            <path d="M2 8h20"/>
            <path d="M6 12h4"/>
            <path d="M6 16h2"/>
            <circle cx="17" cy="14" r="2.5"/>
          </svg>
        </div>
        <h3 class="tb-title">Server UE Frankfurt</h3>
        <p class="tb-text">
          Date stocate exclusiv în Uniunea Europeană. Niciodată nu părăsesc spațiul UE.
        </p>
      </div>

      <!-- Card 3: Stripe -->
      <div class="tb-card">
        <div class="tb-icon-wrap tb-icon--card">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="5" width="20" height="14" rx="2"/>
            <line x1="2" y1="10" x2="22" y2="10"/>
            <line x1="6" y1="15" x2="10" y2="15"/>
          </svg>
        </div>
        <h3 class="tb-title">Plată sigură Stripe</h3>
        <p class="tb-text">
          Procesat prin Stripe — standard global pentru plăți online, certificat PCI-DSS.
        </p>
      </div>

      <!-- Card 4: Trial -->
      <div class="tb-card">
        <div class="tb-icon-wrap tb-icon--trial">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
        </div>
        <h3 class="tb-title">7 zile fără card</h3>
        <p class="tb-text">
          Trial complet, fără să ne dai cardul. Anulezi oricând, fără angajament.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .tb {
    width: 100%;
    background: white;
    padding: 4rem 0;
  }

  .tb-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* === Heading === */
  .tb-heading {
    font-size: 28px;
    font-weight: 700;
    color: #0f172a;
    text-align: center;
    margin: 0 0 0.5rem;
    letter-spacing: -0.02em;
  }

  .tb-subheading {
    font-size: 16px;
    color: #64748b;
    text-align: center;
    margin: 0 0 3rem;
    line-height: 1.5;
  }

  /* === Grid === */
  .tb-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }

  /* === Card === */
  .tb-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 1.75rem 1.5rem;
    text-align: left;
    transition: all 0.25s ease;
  }

  .tb-card:hover {
    background: white;
    border-color: #cbd5e1;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
  }

  /* === Icon === */
  .tb-icon-wrap {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
  }

  .tb-icon-wrap svg {
    width: 24px;
    height: 24px;
  }

  .tb-icon--shield {
    background: rgba(34, 197, 94, 0.1);
    color: #16a34a;
  }

  .tb-icon--eu {
    background: rgba(14, 165, 233, 0.1);
    color: #0284c7;
  }

  .tb-icon--card {
    background: rgba(168, 85, 247, 0.1);
    color: #9333ea;
  }

  .tb-icon--trial {
    background: rgba(251, 146, 60, 0.1);
    color: #ea580c;
  }

  /* === Text === */
  .tb-title {
    font-size: 16px;
    font-weight: 600;
    color: #0f172a;
    margin: 0 0 0.5rem;
    line-height: 1.3;
  }

  .tb-text {
    font-size: 13px;
    color: #64748b;
    margin: 0;
    line-height: 1.55;
  }

  /* === Tablet — 2x2 === */
  @media (max-width: 900px) {
    .tb-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }

    .tb-heading {
      font-size: 24px;
    }
  }

  /* === Mobile — 1 col === */
  @media (max-width: 540px) {
    .tb {
      padding: 3rem 0;
    }

    .tb-grid {
      grid-template-columns: 1fr;
    }

    .tb-card {
      padding: 1.5rem 1.25rem;
    }

    .tb-heading {
      font-size: 22px;
    }

    .tb-subheading {
      font-size: 14px;
      margin-bottom: 2rem;
    }
  }
</style>

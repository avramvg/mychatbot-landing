---
const features = [
  {
    bg: '#e0f2fe', icon: '#0369a1',
    title: 'Răspunsuri 24/7',
    desc: 'Răspunde instantaneu la orice oră, inclusiv noaptea și în weekend.',
    svg: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
  },
  {
    bg: '#d1fae5', icon: '#065f46',
    title: 'Răspunsuri cu surse',
    desc: 'Trimite vizitatorii la paginile relevante cu linkuri directe din site-ul tău.',
    svg: '<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>',
  },
  {
    bg: '#fef3c7', icon: '#92400e',
    title: 'Verificare disponibilitate',
    desc: 'Sincronizare iCal cu Booking.com și Airbnb în timp real.',
    svg: '<rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>',
  },
  {
    bg: '#ede9fe', icon: '#5b21b6',
    title: 'Preluare cereri (handoff)',
    desc: 'Colectează date de contact și trimite cererile pe email. Formular GDPR inclus.',
    svg: '<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>',
  },
  {
    bg: '#e0f2fe', icon: '#0369a1',
    title: 'Butoane de comunicare ghidată',
    desc: 'Quick replies configurabile. Ghidează vizitatorii spre cele mai frecvente întrebări.',
    svg: '<rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/>',
  },
  {
    bg: '#d1fae5', icon: '#065f46',
    title: 'FAQ automat generat AI',
    desc: 'Generăm automat întrebările frecvente din site. Tu le aprobi și editezi.',
    svg: '<path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>',
  },
  {
    bg: '#fce7f3', icon: '#9d174d',
    title: 'Recomandări AI',
    desc: 'Ghidează vizitatorii spre cea mai bună opțiune din oferta ta.',
    svg: '<circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/>',
  },
  {
    bg: '#fef3c7', icon: '#92400e',
    title: 'Upselling proactiv AI',
    desc: 'Sugerează servicii complementare. Camera → mic dejun, transfer, excursii.',
    svg: '<line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>',
  },
  {
    bg: '#ede9fe', icon: '#5b21b6',
    title: 'GDPR complet',
    desc: 'Consimțământ, politică de confidențialitate, server UE, multilingv automat.',
    svg: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
  },
];
---
<section>
  <div class="container">
    <span class="section-tag">Funcționalități cheie</span>
    <h2>Tot ce ai nevoie, inclus</h2>
    <div class="features-grid mt-3">
      {features.map((f) => (
        <div class="feature-card">
          <div class="feat-icon" style={`background:${f.bg}`}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke={f.icon} stroke-width="2" set:html={f.svg} />
          </div>
          <h3>{f.title}</h3>
          <p>{f.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  .feature-card {
    background: var(--color-bg-subtle);
    border-radius: 12px;
    padding: 1.1rem;
  }
  .feat-icon {
    width: 32px; height: 32px;
    border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 10px;
  }
  .feature-card p { font-size: 12px; margin-top: 4px; }
  @media (max-width: 768px) {
    .features-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>

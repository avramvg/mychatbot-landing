<section class="cta-section">
  <div class="container">
    <div class="cta-box">
      <h2 class="cta-title">Pornește chatbot-ul tău AI azi</h2>
      <p class="cta-sub">7 zile gratuit · Fără card · Configurare în 10 minute</p>
      <a href="https://app.mychatbot.ro/signup" class="cta-btn">
        Încearcă gratuit 7 zile →
      </a>
    </div>
  </div>
</section>

<style>
  .cta-section { border-bottom: none; }
  .cta-box {
    background: #0f172a;
    border-radius: 12px;
    padding: 2.5rem;
    text-align: center;
  }
  .cta-title {
    font-size: 28px;
    font-weight: 500;
    color: white;
    margin-bottom: 0.75rem;
  }
  .cta-sub {
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 1.5rem;
    font-size: 15px;
  }
  .cta-btn {
    background: var(--color-primary);
    color: white;
    padding: 14px 32px;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 500;
    text-decoration: none;
    display: inline-block;
    transition: background 0.15s;
  }
  .cta-btn:hover { background: var(--color-primary-dark); }
</style>

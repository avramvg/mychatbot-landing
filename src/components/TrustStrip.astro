---
// TrustStrip.astro
//
// Bară orizontală cu 4 metrici cheie despre produs.
// Plasare: imediat sub Hero, înainte de IntegrationsStrip.
// Rol: validare rapidă — ce primești, fără claim-uri inventate.
//
// Metrici afișate (toate verificabile real):
//   ⏱️  Live în 10 minute
//   🌍  50+ limbi
//   ⚡  Răspuns sub 2 secunde
//   🛠️  Fără cod, fără PMS
---

<section class="ts" aria-label="Beneficii cheie">
  <div class="ts-container">
    <div class="ts-item">
      <span class="ts-icon" aria-hidden="true">⏱️</span>
      <div class="ts-text">
        <span class="ts-value">Live în 10 minute</span>
        <span class="ts-label">de la înregistrare</span>
      </div>
    </div>

    <div class="ts-divider" aria-hidden="true"></div>

    <div class="ts-item">
      <span class="ts-icon" aria-hidden="true">🌍</span>
      <div class="ts-text">
        <span class="ts-value">50+ limbi</span>
        <span class="ts-label">detectate automat</span>
      </div>
    </div>

    <div class="ts-divider" aria-hidden="true"></div>

    <div class="ts-item">
      <span class="ts-icon" aria-hidden="true">⚡</span>
      <div class="ts-text">
        <span class="ts-value">Răspuns sub 2s</span>
        <span class="ts-label">la orice întrebare</span>
      </div>
    </div>

    <div class="ts-divider" aria-hidden="true"></div>

    <div class="ts-item">
      <span class="ts-icon" aria-hidden="true">🛠️</span>
      <div class="ts-text">
        <span class="ts-value">Fără cod</span>
        <span class="ts-label">fără programator, fără bătaie de cap</span>
      </div>
    </div>
  </div>
</section>

<style>
  .ts {
    width: 100%;
    background: #ffffff;
    border-top: 1px solid #f1f5f9;
    border-bottom: 1px solid #f1f5f9;
    padding: 1.25rem 0;
  }

  .ts-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .ts-item {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1;
    min-width: 0;
  }

  .ts-icon {
    font-size: 24px;
    flex-shrink: 0;
    line-height: 1;
  }

  .ts-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .ts-value {
    font-size: 14px;
    font-weight: 600;
    color: #0f172a;
    line-height: 1.3;
    white-space: nowrap;
  }

  .ts-label {
    font-size: 12px;
    color: #64748b;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .ts-divider {
    width: 1px;
    height: 32px;
    background: #e2e8f0;
    flex-shrink: 0;
  }

  /* Tablet */
  @media (max-width: 900px) {
    .ts-label {
      display: none;
    }
    .ts-value {
      font-size: 13px;
    }
  }

  /* Mobile — wrap pe 2 rânduri × 2 coloane */
  @media (max-width: 640px) {
    .ts {
      padding: 1rem 0;
    }

    .ts-container {
      flex-wrap: wrap;
      gap: 0.75rem;
      padding: 0 1rem;
    }

    .ts-item {
      flex: 1 1 calc(50% - 0.375rem);
      min-width: calc(50% - 0.375rem);
      justify-content: flex-start;
    }

    .ts-divider {
      display: none;
    }

    .ts-icon {
      font-size: 20px;
    }

    .ts-value {
      font-size: 12px;
    }
  }
</style>

---
const plans = [
  {
    id: 'start',
    name: 'Start',
    price: '150 lei',
    desc: 'Pentru pensiuni mici, restaurante, cafenele și atracții locale din turism și ospitalitate.',
    featured: false,
    cta: { label: 'Începe gratuit', href: 'https://app.mychatbot.ro/signup', style: 'secondary' },
    features: [
      { ok: true,  text: '~150 conversații/lună' },
      { ok: true,  text: 'Crawl automat lunar' },
      { ok: true,  text: '1 crawl manual/lună' },
      { ok: true,  text: '1 document upload' },
      { ok: true,  text: 'Mod widget: FAB flotant' },
      { ok: true,  text: 'Cereri de contact (formular simplu)' },
      { ok: true,  text: 'Portal client' },
      { ok: true,  text: 'Rapoarte de bază' },
      { ok: false, text: 'Verificare disponibilitate iCal' },
      { ok: false, text: 'Formulare inteligente per tip cerere' },
      { ok: false, text: 'Răspunsuri sugerate' },
      { ok: false, text: 'Mod Inline/Sidebar' },
      { ok: null,  text: 'Branding „MyChatbot" vizibil' },
    ],
  },
  {
    id: 'standard',
    name: 'Standard',
    price: '250 lei',
    desc: 'Pentru hoteluri boutique, agenții de turism mici, pensiuni active și restaurante cu rezervări.',
    featured: true,
    badge: 'Recomandat',
    cta: { label: 'Începe gratuit', href: 'https://app.mychatbot.ro/signup', style: 'primary' },
    features: [
      { ok: true,  text: '~500 conversații/lună' },
      { ok: true,  text: 'Crawl automat săptămânal' },
      { ok: true,  text: '2 crawluri manuale/lună' },
      { ok: true,  text: '4 documente upload' },
      { ok: true,  text: 'Verificare disponibilitate iCal' },
      { ok: true,  text: 'Moduri widget: FAB + Inline + Sidebar' },
      { ok: true,  text: 'Formulare inteligente per tip cerere (cazare, programare, ofertă)' },
      { ok: true,  text: 'Răspunsuri sugerate' },
      { ok: true,  text: 'Portal client complet' },
      { ok: true,  text: 'Rapoarte standard' },
      { ok: true,  text: 'Fără branding MyChatbot' },
    ],
  },
  {
    id: 'pro',
    name: 'Pro',
    price: '550 lei',
    desc: 'Pentru hoteluri cu peste 30 camere, tour operatori, agenții cu volum și destinații turistice.',
    featured: false,
    cta: { label: 'Începe gratuit', href: 'https://app.mychatbot.ro/signup', style: 'secondary' },
    features: [
      { ok: true,  text: 'Conversații nelimitate' },
      { ok: true,  text: 'Crawl automat zilnic' },
      { ok: true,  text: 'Crawluri manuale nelimitate' },
      { ok: true,  text: '10 documente upload' },
      { ok: true,  text: 'Verificare disponibilitate iCal' },
      { ok: true,  text: 'Toate modurile widget (inclusiv Modal)' },
      { ok: true,  text: 'Formulare inteligente per tip cerere' },
      { ok: true,  text: 'Răspunsuri sugerate' },
      { ok: true,  text: 'Portal client complet' },
      { ok: true,  text: 'Rapoarte avansate + export CSV' },
      { ok: true,  text: 'Fără branding MyChatbot' },
      { ok: true,  text: 'Suport prioritar 24h' },
    ],
  },
  {
    id: 'enterprise',
    name: 'Enterprise',
    price: 'Preț negociat',
    priceSmall: true,
    desc: 'Pentru lanțuri hoteliere, operatori de turism și destinații turistice cu volum.',
    featured: false,
    cta: { label: 'Contactează-ne →', href: 'mailto:hello@helloweb.ro', style: 'secondary' },
    features: [
      { ok: true, text: 'Conversații nelimitate' },
      { ok: true, text: 'SLA garantat contractual' },
      { ok: true, text: 'Integrări personalizate' },
      { ok: true, text: 'Suport dedicat' },
      { ok: true, text: 'Facturare personalizată' },
      { ok: true, text: 'Onboarding asistat' },
    ],
  },
];
---
<section id="preturi">
  <div class="container">
    <span class="section-tag">Prețuri</span>
    <h2>Alege planul potrivit</h2>
    <p>Toate planurile includ 7 zile gratuit. Fără card.</p>

    <div class="plans-grid mt-4">
      {plans.map((p) => (
        <div class={`plan-card ${p.featured ? 'featured' : ''}`}>
          {p.badge && <div class="plan-badge">{p.badge}</div>}
          <div class="plan-name">{p.name}</div>
          <div class={`plan-price ${p.priceSmall ? 'plan-price-sm' : ''}`}>
            {p.price}{!p.priceSmall && <span>/lună</span>}
          </div>
          <div class="plan-desc">{p.desc}</div>
          <ul class="plan-features">
            {p.features.map((f) => (
              <li>
                <span class={f.ok === true ? 'ck' : f.ok === false ? 'xx' : 'nd'}>
                  {f.ok === true ? '✓' : f.ok === false ? '✕' : '—'}
                </span>
                {f.text}
              </li>
            ))}
          </ul>
          <a
            href={p.cta.href}
            class={p.cta.style === 'primary' ? 'btn-primary plan-btn' : 'btn-secondary plan-btn'}
          >
            {p.cta.label}
          </a>
        </div>
      ))}
    </div>

    <!-- Taglines motivaționale sub grid -->
    <div class="pricing-hints mt-4">
      <p>💡 O rezervare directă în plus pe lună acoperă abonamentul întreg.</p>
      <p>Cu cât business-ul tău crește, cu atât costul per conversație scade.</p>
    </div>

    <!-- Non-profit -->
    <div class="nonprofit-box mt-4">
      <div class="nonprofit-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#065f46" stroke-width="2">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
      </div>
      <div>
        <h3>30% reducere pentru non-profit și instituții educaționale</h3>
        <p>ONG-uri, școli, universități, muzee și instituții culturale beneficiază de reducere permanentă pe planurile Standard și Pro. Contactați-ne cu documentele organizației.</p>
        <a href="mailto:hello@helloweb.ro" class="nonprofit-link">Solicită reducerea → hello@helloweb.ro</a>
      </div>
    </div>

    <div class="helloweb-box">
      <div class="helloweb-content">
        <span class="helloweb-icon">🌐</span>
        <div>
          <p class="helloweb-title">Nu ai încă un site pentru afacerea ta?</p>
          <p class="helloweb-desc">Hello Web creează site-uri profesionale pentru HoReCa și orice business — gata în 5 zile, optimizat pentru chatbot din prima zi.</p>
        </div>
      </div>
      <a href="https://helloweb.ro" target="_blank" rel="noopener noreferrer" class="helloweb-btn">
        Vezi pachete Hello Web →
      </a>
    </div>
  </div>
</section>

<style>
  .plans-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }
  .plan-card {
    background: white;
    border: 0.5px solid var(--color-border);
    border-radius: 12px;
    padding: 1.1rem;
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .plan-card.featured { border: 2px solid var(--color-primary); background: #f0f9ff; }
  .plan-badge {
    position: absolute;
    top: -10px; left: 50%;
    transform: translateX(-50%);
    background: var(--color-primary);
    color: white;
    font-size: 11px; font-weight: 500;
    padding: 3px 14px;
    border-radius: 20px;
    white-space: nowrap;
  }
  .plan-name {
    font-size: 11px; font-weight: 500;
    color: var(--color-slate);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .plan-price {
    font-size: 24px; font-weight: 500;
    color: var(--color-dark);
    margin: 5px 0 3px;
  }
  .plan-price-sm { font-size: 16px; margin: 6px 0; }
  .plan-price span { font-size: 11px; font-weight: 400; color: var(--color-slate); }
  .plan-desc {
    font-size: 11px; color: var(--color-slate);
    margin-bottom: 12px;
    line-height: 1.5;
  }
  .plan-features {
    list-style: none;
    margin-bottom: 1rem;
    flex: 1;
  }
  .plan-features li {
    font-size: 11px; color: var(--color-slate);
    padding: 3px 0;
    border-bottom: 0.5px solid var(--color-border);
    display: flex; align-items: flex-start; gap: 4px;
    line-height: 1.4;
  }
  .plan-features li:last-child { border-bottom: none; }
  .ck { color: #10b981; font-size: 10px; flex-shrink: 0; margin-top: 2px; }
  .xx { color: #ef4444; font-size: 10px; flex-shrink: 0; margin-top: 2px; }
  .nd { color: #94a3b8; font-size: 10px; flex-shrink: 0; margin-top: 2px; }
  .plan-btn {
    width: 100%;
    text-align: center;
    display: block;
    font-size: 12px;
    padding: 9px 12px;
  }

  /* Hints motivaționale */
  .pricing-hints {
    text-align: center;
    font-size: 13px;
    color: var(--color-slate);
    font-style: italic;
    line-height: 1.8;
  }

  /* Non-profit */
  .nonprofit-box {
    background: var(--color-bg-subtle);
    border-radius: 12px;
    padding: 1.25rem;
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }
  .nonprofit-icon {
    width: 36px; height: 36px;
    background: #d1fae5;
    border-radius: 8px;
    flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
  }
  .nonprofit-box h3 { font-size: 14px; margin-bottom: 4px; }
  .nonprofit-box p  { font-size: 12px; }
  .nonprofit-link {
    font-size: 12px; color: var(--color-primary);
    text-decoration: none; font-weight: 500;
    margin-top: 6px; display: inline-block;
  }
  .nonprofit-link:hover { text-decoration: underline; }

  @media (max-width: 900px) {
    .plans-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 540px) {
    .plans-grid { grid-template-columns: 1fr; }
  }

  .helloweb-box {
    max-width: 860px;
    margin: 2rem auto 0;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .helloweb-content {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1;
    min-width: 200px;
  }
  .helloweb-icon {
    font-size: 28px;
    flex-shrink: 0;
  }
  .helloweb-title {
    font-size: 14px;
    font-weight: 600;
    color: #0f172a;
    margin: 0 0 2px;
  }
  .helloweb-desc {
    font-size: 12px;
    color: #64748b;
    margin: 0;
    line-height: 1.5;
  }
  .helloweb-btn {
    display: inline-block;
    padding: 8px 20px;
    border: 1.5px solid #2563eb;
    border-radius: 8px;
    color: #2563eb;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.15s;
    flex-shrink: 0;
  }
  .helloweb-btn:hover {
    background: #eff6ff;
  }
  @media (max-width: 600px) {
    .helloweb-box { flex-direction: column; align-items: flex-start; }
  }
</style>

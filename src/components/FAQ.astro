---
import { faqs } from '../data/faqs';
---
<section id="faq" class="gray-section">
  <div class="container">
    <span class="section-tag">Întrebări frecvente</span>
    <h2>Ai întrebări?</h2>
    <div class="faq-grid mt-3">
      {faqs.map((f) => (
        <div class="faq-item">
          <h3>{f.q}</h3>
          <p style="white-space: pre-line;">{f.a}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .gray-section { background: #f8fafc; }
  .faq-grid {
    columns: 2;
    column-gap: 3rem;
  }
  .faq-item {
    break-inside: avoid;
    margin-bottom: 1.5rem;
  }
  .faq-item h3 { margin-bottom: 5px; }
  .faq-item p  { font-size: 12px; }
  @media (max-width: 640px) {
    .faq-grid { columns: 1; }
  }
</style>

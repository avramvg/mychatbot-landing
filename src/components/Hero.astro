---
<section class="hero-section">
  <div class="container hero-grid">

    <!-- Text -->
    <div class="hero-text">
      <div class="hero-badge">7 zile gratuit · fără card</div>
      <h1>Chatbot AI pentru turism și HoReCa</h1>
      <p class="hero-sub">
        Transformă vizitatorii în clienți. MyChatbot răspunde automat 24/7 ca un concierge de 5 stele,
        verifică disponibilitatea și preia cererile de rezervare.
      </p>
      <div class="hero-btns">
        <a href="https://app.mychatbot.ro/signup" class="btn-primary">Începe trial gratuit 7 zile →</a>
        <a href="#demo" class="btn-secondary">Vezi demo live</a>
      </div>
      <div class="trust-list">
        <div class="trust-item"><span class="check">✓</span>Fără card de credit</div>
        <div class="trust-item"><span class="check">✓</span>Configurare în 10 minute</div>
        <div class="trust-item"><span class="check">✓</span>GDPR complet · Server UE</div>
        <div class="trust-item"><span class="check">✓</span>Anulezi oricând · Fără angajament</div>
      </div>
    </div>

    <!-- Device mockups -->
    <div class="mockups-wrap">

      <!-- Desktop -->
      <div class="desktop-mock">
        <div class="browser-bar">
          <div class="dots">
            <span class="dot red"></span>
            <span class="dot yellow"></span>
            <span class="dot green"></span>
          </div>
        </div>
        <div class="browser-content">
          <div class="page-skeleton">
            <div class="skel skel-title"></div>
            <div class="skel skel-line w-80"></div>
            <div class="skel skel-line w-50"></div>
            <div class="skel-blocks">
              <div class="skel skel-block"></div>
              <div class="skel skel-block"></div>
            </div>
          </div>
          <!-- Chat widget overlay -->
          <div class="chat-overlay">
            <div class="chat-bubble bot">
              <div class="chat-name">MyChatbot</div>
              <div class="chat-text">Bună! Cu ce vă pot ajuta astăzi?</div>
            </div>
            <div class="chat-bubble user">
              <div class="chat-text">Aveți camere libere?</div>
            </div>
            <div class="chat-bubble bot">
              <div class="chat-text">Da! Camera Deluxe e disponibilă. <span class="chat-link">Vezi detalii →</span></div>
            </div>
            <div class="chat-fab">
              <span></span><span></span><span></span>
            </div>
          </div>
        </div>
        <div class="monitor-stem"></div>
        <div class="monitor-foot"></div>
      </div>

      <!-- Mobile -->
      <div class="mobile-mock">
        <div class="mobile-frame">
          <div class="mobile-header">
            <div class="mobile-title">Pensiunea Alexa</div>
            <div class="mobile-status">Online</div>
          </div>
          <div class="mobile-body">
            <div class="m-bubble bot-m">Bună! Cum vă pot ajuta?</div>
            <div class="m-bubble user-m">Prețuri camere?</div>
            <div class="m-bubble bot-m">Camera Standard: 200 lei/noapte. <span class="chat-link-m">Vezi →</span></div>
            <div class="quick-replies">
              <span class="qr">Disponibilitate</span>
              <span class="qr">Contact</span>
            </div>
          </div>
          <div class="mobile-input">Scrieți un mesaj...</div>
          <div class="home-indicator"></div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .hero-section { padding: 4rem 0; border-bottom: 0.5px solid var(--color-border); }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  .hero-badge {
    display: inline-block;
    background: #fef3c7;
    color: #92400e;
    font-size: 11px;
    font-weight: 500;
    padding: 3px 12px;
    border-radius: 20px;
    margin-bottom: 1rem;
  }
  h1 { margin-bottom: 2rem; }
  .hero-sub { font-size: 16px; margin-bottom: 2rem; }
  .hero-btns { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 1.5rem; }
  .trust-list { display: flex; flex-direction: row; gap: 1.25rem; flex-wrap: wrap; }
  .check { color: #10b981; }

  /* Mockups */
  .mockups-wrap { position: relative; height: 340px; }

  /* Desktop */
  .desktop-mock {
    position: absolute; left: 0; top: 0; width: 280px;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.15), 0 8px 24px rgba(0, 0, 0, 0.08);
    transform: perspective(1000px) rotateY(-4deg) rotateX(2deg);
    transition: transform 0.3s ease;
    border-radius: 10px;
  }
  .browser-bar {
    background: #1e293b;
    border-radius: 10px 10px 0 0;
    padding: 7px 10px 0;
  }
  .dots { display: flex; gap: 4px; margin-bottom: 5px; }
  .dot { width: 8px; height: 8px; border-radius: 50%; }
  .red    { background: #ef4444; }
  .yellow { background: #f59e0b; }
  .green  { background: #10b981; }
  .browser-content {
    background: #f8fafc;
    border-radius: 0 0 4px 4px;
    padding: 10px;
    min-height: 180px;
    position: relative;
    overflow: hidden;
  }
  .skel { background: #e2e8f0; border-radius: 4px; margin-bottom: 5px; height: 9px; }
  .skel-title { height: 11px; width: 55%; }
  .w-80  { width: 80%; }
  .w-50  { width: 50%; }
  .skel-blocks { display: flex; gap: 6px; margin-top: 10px; }
  .skel-block  { background: #e2e8f0; height: 40px; border-radius: 6px; flex: 1; }
  .chat-overlay {
    position: absolute; bottom: 8px; right: 8px; width: 120px;
    display: flex; flex-direction: column; gap: 4px;
  }
  .chat-bubble { border-radius: 8px; padding: 6px 8px; }
  .chat-bubble.bot { background: #0f172a; border-radius: 8px 8px 8px 2px; }
  .chat-bubble.user { background: #0ea5e9; border-radius: 2px 8px 8px 8px; text-align: right; }
  .chat-name { font-size: 8px; color: #94a3b8; margin-bottom: 2px; }
  .chat-text { font-size: 8px; color: white; line-height: 1.4; }
  .chat-link { color: #38bdf8; text-decoration: underline; }
  .chat-fab {
    width: 28px; height: 28px; background: #0ea5e9;
    border-radius: 50%; margin-top: 4px; margin-left: auto;
    display: flex; align-items: center; justify-content: center; gap: 2px;
  }
  .chat-fab span {
    width: 4px; height: 4px; background: white; border-radius: 50%; display: block;
  }
  .chat-fab span:nth-child(2) { opacity: 0.6; }
  .chat-fab span:nth-child(3) { opacity: 0.3; }
  .monitor-stem { background: #94a3b8; height: 4px; border-radius: 0 0 4px 4px; }
  .monitor-foot { background: #94a3b8; height: 14px; width: 60px; margin: 0 auto; border-radius: 0 0 4px 4px; }

  /* Mobile */
  .mobile-mock {
    position: absolute; right: 0; top: 30px; width: 112px;
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.2), 0 8px 16px rgba(0, 0, 0, 0.1);
    transform: perspective(800px) rotateY(3deg) rotateX(-1deg);
    transition: transform 0.3s ease;
    border-radius: 18px;
  }
  .mobile-frame {
    background: #1e293b; border-radius: 18px;
    padding: 6px; border: 2px solid #334155;
    overflow: hidden;
  }
  .mobile-header {
    background: #0ea5e9; padding: 8px; text-align: center; border-radius: 10px 10px 0 0;
  }
  .mobile-title { font-size: 9px; font-weight: 500; color: white; }
  .mobile-status { font-size: 7px; color: rgba(255,255,255,0.8); }
  .mobile-body {
    background: #f8fafc; padding: 8px;
    display: flex; flex-direction: column; gap: 5px;
    min-height: 140px;
  }
  .m-bubble { border-radius: 6px; padding: 5px 7px; font-size: 7px; line-height: 1.4; }
  .bot-m  { background: #e2e8f0; color: #374151; border-radius: 6px 6px 6px 2px; }
  .user-m { background: #0ea5e9; color: white; border-radius: 6px 6px 2px 6px; align-self: flex-end; }
  .chat-link-m { color: #0ea5e9; }
  .quick-replies { display: flex; flex-wrap: wrap; gap: 3px; margin-top: 2px; }
  .qr {
    background: #e0f2fe; color: #0369a1; border-radius: 10px;
    padding: 2px 6px; font-size: 6px;
  }
  .mobile-input {
    background: white; border-top: 0.5px solid #e2e8f0;
    padding: 6px 8px; font-size: 7px; color: #94a3b8; border-radius: 0 0 10px 10px;
  }
  .home-indicator {
    width: 30px; height: 3px; background: #334155;
    border-radius: 4px; margin: 4px auto 0;
  }

  .mockups-wrap:hover .desktop-mock {
    transform: perspective(1000px) rotateY(-2deg) rotateX(1deg);
  }
  .mockups-wrap:hover .mobile-mock {
    transform: perspective(800px) rotateY(1deg) rotateX(0deg);
  }

  @media (max-width: 768px) {
    .hero-grid { grid-template-columns: 1fr; }
    .mockups-wrap { display: none; }
  }
</style>

---
import HeroChatAnimation from '../components/HeroChatAnimation.astro';
---
<section class="hero-section">
  <div class="container hero-grid">

    <!-- Text -->
    <div class="hero-text">
      <div class="hero-badge">7 zile gratuit · fără card</div>
      <h1>Chatbot AI pentru turism și HoReCa</h1>
      <p class="hero-sub">
        Transformă vizitatorii în clienți. MyChatbot răspunde automat 24/7 ca un concierge de 5 stele,
        verifică disponibilitatea și preia cererile de rezervare.
      </p>
      <div class="hero-btns">
        <a href="https://app.mychatbot.ro/signup" class="btn-primary">Începe trial gratuit 7 zile →</a>
        <a href="#demo" class="btn-secondary">Vezi demo live</a>
      </div>
      <div class="trust-list">
        <div class="trust-item"><span class="check">✓</span>Fără card de credit</div>
        <div class="trust-item"><span class="check">✓</span>Configurare în 10 minute</div>
        <div class="trust-item"><span class="check">✓</span>GDPR complet · Server UE</div>
        <div class="trust-item"><span class="check">✓</span>Anulezi oricând · Fără angajament</div>
      </div>
    </div>

    <!-- Chat animation -->
    <HeroChatAnimation />
  </div>
</section>

<style>
  .hero-section { padding: 4rem 0; border-bottom: 0.5px solid var(--color-border); }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  .hero-badge {
    display: inline-block;
    background: #fef3c7;
    color: #92400e;
    font-size: 11px;
    font-weight: 500;
    padding: 3px 12px;
    border-radius: 20px;
    margin-bottom: 1rem;
  }
  h1 { margin-bottom: 2rem; }
  .hero-sub { font-size: 16px; margin-bottom: 2rem; }
  .hero-btns { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 1.5rem; }
  .trust-list { display: flex; flex-direction: row; gap: 1.25rem; flex-wrap: wrap; }
  .check { color: #10b981; }

  @media (max-width: 768px) {
    .hero-grid { grid-template-columns: 1fr; }
  }
</style>

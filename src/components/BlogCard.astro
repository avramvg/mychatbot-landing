---
interface Props {
  title:       string
  description: string
  pubDate:     Date
  slug:        string
  image:       string
  imageAlt:    string
  tags:        string[]
}

const { title, description, pubDate, slug, image, imageAlt, tags } = Astro.props

const dateStr = pubDate.toLocaleDateString('ro-RO', {
  day: 'numeric', month: 'long', year: 'numeric'
})
---

<a href={`/blog/${slug}`} class="blog-card">
  <div class="blog-card-img-wrap">
    <img src={image} alt={imageAlt} loading="lazy" class="blog-card-img" />
  </div>
  <div class="blog-card-body">
    {tags.length > 0 && (
      <div class="blog-card-tags">
        {tags.slice(0, 2).map((tag) => (
          <span class="blog-tag">{tag}</span>
        ))}
      </div>
    )}
    <h3 class="blog-card-title">{title}</h3>
    <p class="blog-card-desc">{description}</p>
    <div class="blog-card-footer">
      <span class="blog-card-date">{dateStr}</span>
      <span class="blog-card-cta">Citește →</span>
    </div>
  </div>
</a>

<style>
  .blog-card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 0.5px solid var(--color-border);
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .blog-card:hover {
    box-shadow: 0 8px 28px rgba(0,0,0,0.09);
    transform: translateY(-2px);
  }

  .blog-card-img-wrap {
    width: 100%;
    aspect-ratio: 16/9;
    overflow: hidden;
    background: #f1f5f9;
  }
  .blog-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .blog-card:hover .blog-card-img {
    transform: scale(1.03);
  }

  .blog-card-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.5rem;
  }

  .blog-card-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .blog-tag {
    font-size: 11px;
    font-weight: 600;
    color: var(--color-primary);
    background: #e0f2fe;
    padding: 2px 8px;
    border-radius: 20px;
    letter-spacing: 0.3px;
  }

  .blog-card-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-dark);
    line-height: 1.45;
    margin: 0;
  }
  .blog-card-desc {
    font-size: 0.8rem;
    color: var(--color-slate);
    line-height: 1.6;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.5rem;
    padding-top: 0.75rem;
    border-top: 0.5px solid var(--color-border);
  }
  .blog-card-date {
    font-size: 11px;
    color: #94a3b8;
  }
  .blog-card-cta {
    font-size: 12px;
    font-weight: 600;
    color: var(--color-primary);
  }
</style>

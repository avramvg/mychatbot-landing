---
const cards = [
  {
    icon: '🏡',
    title: 'Pensiuni & case de vacanță',
    text: 'Răspunde automat la întrebări despre camere, prețuri și disponibilitate.',
    plan: 'Start',
  },
  {
    icon: '🍽️',
    title: 'Restaurante & cafenele',
    text: 'Program, rezervări, meniu și evenimente speciale — disponibil 24/7.',
    plan: 'Start',
  },
  {
    icon: '🗺️',
    title: 'Ghizi & atracții locale mici',
    text: 'Informații despre tururi, prețuri și programări, instant.',
    plan: 'Start',
  },
  {
    icon: '🏨',
    title: 'Hoteluri boutique',
    text: 'Oferă detalii complete, verifică disponibilitatea, preia cereri și upsell servicii suplimentare.',
    plan: 'Standard',
  },
  {
    icon: '✈️',
    title: 'Agenții de turism',
    text: 'Răspunde la întrebări despre pachete, destinații și prețuri instant. Prezintă link-ul direct al ofertei.',
    plan: 'Standard',
  },
  {
    icon: '🏕️',
    title: 'Atracții, parcuri & complexuri turistice',
    text: 'Gestionează întrebările sezoniere fără să supraîncarci echipa.',
    plan: 'Standard',
  },
  {
    icon: '🏰',
    title: 'Hoteluri & resorturi',
    text: 'Volum mare de conversații, crawl zilnic, rapoarte avansate.',
    plan: 'Pro',
  },
  {
    icon: '🌍',
    title: 'Tour operatori',
    text: 'Automatizează prima interacțiune pentru zeci de clienți interesați zilnic.',
    plan: 'Pro',
  },
  {
    icon: '🏛️',
    title: 'Muzee & destinații turistice',
    text: 'Informații despre program, bilete și evenimente — în orice limbă.',
    plan: 'Pro',
  },
];

const planColor: Record<string, string> = {
  Start:    '#64748b',
  Standard: '#0ea5e9',
  Pro:      '#7c3aed',
};
---

<section class="who-section">
  <div class="container">
    <span class="section-tag">Potrivit pentru</span>
    <h2>Cine folosește MyChatbot?</h2>
    <p>Orice business care primește vizitatori și vrea să răspundă automat, 24/7.</p>

    <div class="who-grid mt-4">
      {cards.map((c) => (
        <div class="who-card">
          <div class="who-icon">{c.icon}</div>
          <div class="who-plan" style={`color: ${planColor[c.plan]}`}>Plan {c.plan}</div>
          <h3 class="who-title">{c.title}</h3>
          <p class="who-text">{c.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .who-section { background: white; }

  .who-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .who-card {
    background: white;
    border: 0.5px solid var(--color-border);
    border-radius: 12px;
    padding: 24px;
    transition: box-shadow 0.15s, border-color 0.15s;
  }
  .who-card:hover {
    box-shadow: 0 4px 16px rgba(0,0,0,0.07);
    border-color: #bae6fd;
  }

  .who-icon {
    font-size: 36px;
    line-height: 1;
    margin-bottom: 8px;
  }

  .who-plan {
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 6px;
  }

  .who-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-dark);
    margin-bottom: 6px;
    line-height: 1.3;
  }

  .who-text {
    font-size: 12px;
    color: var(--color-slate);
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .who-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 540px) {
    .who-grid { grid-template-columns: 1fr; }
  }
</style>

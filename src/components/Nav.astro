---
interface Props { basePath?: string }
const { basePath = '' } = Astro.props
---
<nav>
  <div class="container nav-inner">
    <a href="/" class="logo-link">
      <svg class="logo-icon" viewBox="0 0 62 68" xmlns="http://www.w3.org/2000/svg">
        <path d="M4 6C4 3.8 5.8 2 8 2L54 2C56.2 2 58 3.8 58 6L58 46C58 48.2 56.2 50 54 50L34 50L20 64L20 50L8 50C5.8 50 4 48.2 4 46Z" fill="#3B9EE0"/>
        <polygon points="50,2 52.5,9 60,9 54,13.5 56.5,20.5 50,16 43.5,20.5 46,13.5 40,9 47.5,9" fill="#F5A623"/>
        <circle cx="20" cy="26" r="4.5" fill="white" opacity="0.95"/>
        <circle cx="31" cy="26" r="4.5" fill="white" opacity="0.95"/>
        <circle cx="42" cy="26" r="4.5" fill="white" opacity="0.95"/>
      </svg>
      <div class="logo-text">
        <div class="logo-name">
          <span class="logo-my">my</span>
          <span class="logo-chatbot">CHATBOT</span>
        </div>
        <div class="logo-sub-wrap">
          <span class="logo-sub">by Hello Web</span>
        </div>
      </div>
    </a>
    <div class="nav-links">
      <a href={`${basePath}#functionalitati`}>Funcționalități</a>
      <a href={`${basePath}#preturi`}>Prețuri</a>
      <a href={`${basePath}#demo`}>Demo</a>
      <a href="/industrii">Industrii</a>
      <a href="/blog">Blog</a>
      <a href="https://app.mychatbot.ro/login">Autentificare</a>
      <a href="https://app.mychatbot.ro/signup" class="btn-primary nav-cta">Încearcă gratuit</a>
    </div>
  </div>
</nav>

<style>
  nav {
    position: sticky;
    top: 0;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
    z-index: 100;
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.9rem;
    padding-bottom: 0.9rem;
  }
.nav-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .nav-links a {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    transition: color 0.15s;
  }
  .nav-links a:hover { color: #ffffff; }
  .nav-cta {
    padding: 8px 18px !important;
    font-size: 13px !important;
    color: white !important;
  }
  /* ── Logo ── */
  .logo-link { display: flex; align-items: center; gap: 10px; text-decoration: none; }
  .logo-icon  { width: 36px; height: 34px; flex-shrink: 0; }
  .logo-text  { display: flex; flex-direction: column; gap: 1px; }
  .logo-name  { display: flex; align-items: baseline; gap: 4px; line-height: 1; }
  .logo-my    { font-family: 'Pacifico', cursive; font-size: 28px; color: #F5A623; line-height: 1; }
  .logo-chatbot { font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 23px; color: #FFFFFF; letter-spacing: 2px; line-height: 1; }
  .logo-sub-wrap { display: flex; justify-content: flex-end; }
  .logo-sub   { font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 400; font-size: 10px; color: #cbd5e1; letter-spacing: 0.5px; }

  @media (max-width: 640px) {
    .logo-icon    { width: 28px; height: 27px; }
    .logo-my      { font-size: 22px; }
    .logo-chatbot { font-size: 18px; }
    .logo-sub     { font-size: 9px; }
  }

  @media (max-width: 768px) {
    .nav-links a:not(.nav-cta) { display: none; }
    .nav-links { gap: 0.75rem; }
  }
</style>

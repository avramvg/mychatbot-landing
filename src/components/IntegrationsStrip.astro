---
// IntegrationsStrip.astro
//
// Strip integrări cu fundal dark navy.
// Layout 2 coloane: stânga = 6 wordmark-uri în grid 3×2, dreapta = imagine
// laptop mockup PNG transparent cu chatbot embed.
//
// Plasare: imediat după TrustStrip, înainte de TrustBadges.
// Rol: răspunde la "merge cu site-ul meu?" + "cum arată pe site-ul meu?"
//
// "Construit de Hello Web" eliminat — mutat în footer.
---

<section class="it" aria-label="Integrări și platforme suportate">
  <div class="it-container">
    <div class="it-content">
      <!-- Stânga: 6 wordmark-uri în grid 3×2 -->
      <div class="it-platforms">
        <p class="it-title">Funcționează pe orice site</p>

        <div class="it-grid">
          <span class="it-logo it-logo--wp">WordPress</span>
          <span class="it-logo it-logo--wix">Wix</span>
          <span class="it-logo it-logo--shopify">Shopify</span>
          <span class="it-logo it-logo--webflow">Webflow</span>
          <span class="it-logo it-logo--hellowweb">Hello Web</span>
          <span class="it-logo it-logo--html">HTML / JS</span>
        </div>

        <p class="it-suffix">
          Funcționează pe orice site, simplu, rapid, fără integrări complicate.
        </p>
      </div>

      <!-- Dreapta: laptop mockup PNG transparent -->
      <div class="it-mockup">
        <img
          src="/images/laptop-mockup.png"
          alt="Laptop cu chatbot AI deschis pe un site web"
          loading="lazy"
          width="1200"
          height="674"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .it {
    width: 100%;
    background: #0f172a;
    background-image:
      radial-gradient(circle at 20% 30%, rgba(14, 165, 233, 0.08), transparent 50%),
      radial-gradient(circle at 80% 70%, rgba(168, 85, 247, 0.05), transparent 50%);
    padding: 4.5rem 0;
    position: relative;
    overflow: hidden;
  }

  /* Subtle pattern overlay */
  .it::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 32px 32px;
    pointer-events: none;
  }

  .it-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
    position: relative;
  }

  .it-content {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 4rem;
    align-items: center;
  }

  /* === LEFT: Platforms === */
  .it-platforms {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .it-title {
    font-size: 13px;
    font-weight: 600;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0;
  }

  .it-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem 2rem;
  }

  .it-logo {
    font-size: 19px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.85);
    transition: color 0.2s ease, transform 0.2s ease;
    cursor: default;
    letter-spacing: -0.01em;
    text-align: left;
  }

  .it-logo:hover {
    color: #ffffff;
    transform: translateY(-1px);
  }

  /* Brand-styled wordmarks (subtle distinctive accents) */
  .it-logo--wp {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
  }

  .it-logo--wix {
    font-family: 'Helvetica Neue', system-ui, sans-serif;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .it-logo--shopify {
    font-family: system-ui, -apple-system, sans-serif;
    font-weight: 700;
    color: #95bf47;
  }

  .it-logo--shopify:hover {
    color: #b3d971;
  }

  .it-logo--webflow {
    font-family: system-ui, sans-serif;
    font-weight: 700;
  }

  .it-logo--hellowweb {
    font-family: system-ui, sans-serif;
    font-weight: 700;
    color: #f5a623;
  }

  .it-logo--hellowweb:hover {
    color: #ffc962;
  }

  .it-logo--html {
    font-family: 'Courier New', monospace;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.6);
  }

  .it-logo--html:hover {
    color: rgba(255, 255, 255, 0.9);
  }

  .it-suffix {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.55);
    margin: 0;
    line-height: 1.5;
    max-width: 380px;
  }

  /* === RIGHT: Laptop mockup image === */
  .it-mockup {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .it-mockup img {
    width: 100%;
    max-width: 600px;
    height: auto;
    display: block;
    /* Subtle drop shadow pentru profunzime suplimentară pe fundalul navy */
    filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.3));
  }

  /* === Tablet === */
  @media (max-width: 1024px) {
    .it-content {
      gap: 2.5rem;
    }

    .it-grid {
      gap: 1.25rem 1.5rem;
    }

    .it-logo {
      font-size: 17px;
    }
  }

  /* === Mobile — stack vertical === */
  @media (max-width: 768px) {
    .it {
      padding: 3rem 0;
    }

    .it-content {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .it-platforms {
      gap: 1.5rem;
    }

    .it-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem 1.5rem;
    }

    .it-logo {
      font-size: 16px;
    }

    .it-mockup {
      order: -1;  /* mockup deasupra logos pe mobile */
    }

    .it-mockup img {
      max-width: 480px;
    }

    .it-suffix {
      font-size: 13px;
    }
  }

  /* === Mobile mic === */
  @media (max-width: 480px) {
    .it-grid {
      gap: 1rem;
    }

    .it-logo {
      font-size: 15px;
    }

    .it-mockup img {
      max-width: 380px;
    }
  }
</style>

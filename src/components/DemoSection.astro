---
// DemoSection.astro
//
// Secțiune demo live cu chatbot embedat real.
// Plasare nouă: între TrustBadges și KnowledgeSources (în loc de VideoSection).
// Background: dark navy #0f172a (consistent cu Founder + Nav).
//
// Layout 2 coloane pe desktop:
//   - Stânga: chatbot embedat real (600px înalt) via widget.js
//   - Dreapta: context Sofia + 6 idei testare + bridge CTA
//
// Pe mobile: stack vertical (chat sus, context jos).
---

<section class="demo" id="demo">
  <div class="demo-container">

    <!-- Header centrat -->
    <div class="demo-header">
      <p class="demo-eyebrow">Demo live</p>
      <h2 class="demo-title">Testează concierge-ul AI chiar acum</h2>
      <p class="demo-subtitle">
        Discută cu Sofia, concierge-ul AI configurat pentru un hotel demo. Pune-i orice întrebare ai pune unui recepționer real.
      </p>
    </div>

    <!-- Grid 2 coloane -->
    <div class="demo-grid">

      <!-- ═══ STÂNGA: Chatbot embed cu chenar + stats ═══ -->
      <div class="demo-chat">
        <div class="demo-chat-window">
          <div id="mychatbot"></div>
          <script
            src="https://app.mychatbot.ro/widget.js"
            data-client-id="5fe6055a-89ce-4cb5-be41-c8ce27ebd3da"
            data-mode="inline"
            data-target="#mychatbot"
            async
          ></script>
        </div>

        <!-- Micro-stats sub chat -->
        <div class="demo-chat-stats">
          <div class="demo-stat">
            <span class="demo-stat-icon">⚡</span>
            <span class="demo-stat-text">Răspuns sub 2s</span>
          </div>
          <div class="demo-stat-divider"></div>
          <div class="demo-stat">
            <span class="demo-stat-icon">🌍</span>
            <span class="demo-stat-text">50+ limbi</span>
          </div>
          <div class="demo-stat-divider"></div>
          <div class="demo-stat">
            <span class="demo-stat-icon">🔒</span>
            <span class="demo-stat-text">GDPR · Server UE</span>
          </div>
        </div>
      </div>

      <!-- ═══ DREAPTA: Context + idei + bridge ═══ -->
      <div class="demo-info">

        <!-- Context Sofia -->
        <div class="demo-block">
          <p class="demo-block-eyebrow">👋 Cu cine vorbești</p>
          <p class="demo-block-title">Sofia · Concierge AI</p>
          <p class="demo-block-text">
            Configurată pentru <strong>Hotel Demo</strong> — un hotel fictiv de 3 stele din Brașov cu 42 camere. Sofia cunoaște tarifele, regulamentul, atracțiile din zonă și răspunde în orice limbă.
          </p>
        </div>

        <!-- 6 idei de testare -->
        <div class="demo-block">
          <p class="demo-block-eyebrow">💡 Idei de testare</p>
          <ul class="demo-suggestions">
            <li>"Aveți cameră liberă weekendul viitor pentru 2 persoane?"</li>
            <li>"Cât costă o noapte cu mic dejun inclus?"</li>
            <li>"Acceptați animale de companie?"</li>
            <li>"Care e ora de check-in și check-out?"</li>
            <li>"Ce atracții turistice sunt în apropiere?"</li>
            <li>"Do you speak English?"</li>
          </ul>
        </div>

        <!-- Bridge la conversie -->
        <div class="demo-bridge">
          <p class="demo-bridge-text">
            Chatbot-ul <strong>tău</strong> va răspunde la fel — cu informațiile reale despre pensiunea, hotelul sau restaurantul tău.
          </p>
          <a href="https://app.mychatbot.ro/signup" class="demo-cta" target="_blank" rel="noopener">
            Începe trial 7 zile gratuit →
          </a>
          <p class="demo-cta-sub">Fără card de credit · Configurare în 10 minute</p>
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  /* ═══ Section bg navy + subtle gradient ═══ */
  .demo {
    width: 100%;
    background: #0f172a;
    background-image:
      radial-gradient(circle at 80% 20%, rgba(14, 165, 233, 0.1), transparent 50%),
      radial-gradient(circle at 20% 80%, rgba(168, 85, 247, 0.06), transparent 50%);
    padding: 5rem 0 6rem;
    position: relative;
    overflow: hidden;
  }

  .demo::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 32px 32px;
    pointer-events: none;
  }

  .demo-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
    position: relative;
  }

  /* ═══ Header centrat ═══ */
  .demo-header {
    text-align: center;
    margin-bottom: 3.5rem;
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
  }

  .demo-eyebrow {
    font-size: 13px;
    font-weight: 600;
    color: #38bdf8;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0 0 0.75rem;
  }

  .demo-title {
    font-size: 36px;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
  }

  .demo-subtitle {
    font-size: 16px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
  }

  /* ═══ Grid 2 coloane ═══ */
  .demo-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 3rem;
    align-items: stretch;
  }

  /* ═══ STÂNGA: Chat embed ═══ */
  .demo-chat {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    padding: 12px;
    overflow: hidden;
    box-shadow:
      0 25px 60px rgba(0, 0, 0, 0.4),
      0 0 80px rgba(14, 165, 233, 0.08);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0;
  }

  .demo-chat-window {
    border-radius: 14px;
    overflow: hidden;
  }

  .demo-chat #mychatbot,
  .demo-chat-window #mychatbot {
    width: 100%;
    height: 600px;
    border-radius: 12px;
    overflow: hidden;
  }

  .demo-chat-stats {
    display: flex;
    align-items: center;
    justify-content: space-around;
    padding: 16px 8px;
    gap: 8px;
  }

  .demo-stat {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 1;
    justify-content: center;
  }

  .demo-stat-icon {
    font-size: 16px;
    line-height: 1;
  }

  .demo-stat-text {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.7);
    font-weight: 500;
    white-space: nowrap;
  }

  .demo-stat-divider {
    width: 1px;
    height: 20px;
    background: rgba(255, 255, 255, 0.1);
    flex-shrink: 0;
  }

  /* ═══ DREAPTA: Info ═══ */
  .demo-info {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .demo-block {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 1.5rem;
  }

  .demo-block-eyebrow {
    font-size: 12px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.5);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 0.5rem;
  }

  .demo-block-title {
    font-size: 17px;
    font-weight: 600;
    color: #ffffff;
    margin: 0 0 0.5rem;
  }

  .demo-block-text {
    font-size: 14px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
  }

  .demo-block-text strong {
    color: rgba(255, 255, 255, 0.95);
    font-weight: 600;
  }

  /* Suggestions list */
  .demo-suggestions {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .demo-suggestions li {
    font-size: 13px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.75);
    padding-left: 1.25rem;
    position: relative;
    font-style: italic;
  }

  .demo-suggestions li::before {
    content: '"';
    position: absolute;
    left: 0;
    top: -2px;
    color: #38bdf8;
    font-size: 18px;
    font-style: normal;
    font-weight: 600;
  }

  /* Bridge / CTA */
  .demo-bridge {
    background: linear-gradient(135deg, rgba(14, 165, 233, 0.15), rgba(14, 165, 233, 0.05));
    border: 1px solid rgba(14, 165, 233, 0.25);
    border-radius: 12px;
    padding: 1.5rem;
  }

  .demo-bridge-text {
    font-size: 14px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
    margin: 0 0 1rem;
  }

  .demo-bridge-text strong {
    color: #38bdf8;
    font-weight: 600;
  }

  .demo-cta {
    display: inline-block;
    background: #0ea5e9;
    color: #ffffff;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    padding: 12px 22px;
    border-radius: 8px;
    transition: all 0.2s ease;
    box-shadow: 0 4px 12px rgba(14, 165, 233, 0.4);
  }

  .demo-cta:hover {
    background: #0284c7;
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(14, 165, 233, 0.5);
  }

  .demo-cta-sub {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.5);
    margin: 0.75rem 0 0;
  }

  /* ═══ Tablet ═══ */
  @media (max-width: 1024px) {
    .demo-grid {
      gap: 2rem;
    }

    .demo-title {
      font-size: 30px;
    }

    .demo-chat #mychatbot,
    .demo-chat-window #mychatbot {
      height: 600px;
    }
  }

  /* ═══ Mobile — stack vertical ═══ */
  @media (max-width: 900px) {
    .demo {
      padding: 3.5rem 0 4rem;
    }

    .demo-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .demo-header {
      margin-bottom: 2.5rem;
    }

    .demo-title {
      font-size: 26px;
    }

    .demo-subtitle {
      font-size: 15px;
    }

    .demo-chat #mychatbot,
    .demo-chat-window #mychatbot {
      height: 550px;
    }

    .demo-chat-stats {
      gap: 4px;
      padding: 12px 4px;
    }

    .demo-stat-text {
      font-size: 12px;
    }
  }

  @media (max-width: 480px) {
    .demo-chat #mychatbot,
    .demo-chat-window #mychatbot {
      height: 500px;
    }

    .demo-title {
      font-size: 22px;
    }

    .demo-block,
    .demo-bridge {
      padding: 1.25rem;
    }

    .demo-chat-stats {
      flex-direction: column;
      gap: 8px;
    }

    .demo-stat-divider {
      display: none;
    }
  }
</style>
